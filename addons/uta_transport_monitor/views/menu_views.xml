<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Root Menu: GeoRutex (sequence=1 so GeoRutex opens as the default home app) -->
    <menuitem id="menu_georutex_root"
              name="GeoRutex"
              web_icon="uta_transport_monitor,static/description/icon.png"
              sequence="1"/>

    <!-- 0. Centro de operaciones (Administrador de Transporte) -->
    <menuitem id="menu_georutex_admin_home"
              name="Centro de operaciones"
              parent="menu_georutex_root"
              action="action_transport_admin_home"
              groups="uta_transport_monitor.group_transport_manager"
              sequence="2"/>

    <!-- 0a. Inicio del Conductor (Espacio operativo móvil) -->
    <menuitem id="menu_georutex_driver_home"
              name="Inicio"
              parent="menu_georutex_root"
              action="action_transport_driver_home"
              groups="uta_transport_monitor.group_transport_driver"
              sequence="3"/>

    <!-- 0b. Análisis del servicio (MT-01..08, MCS-01..04) -->
    <menuitem id="menu_georutex_dashboard_main"
              name="Análisis del servicio"
              parent="menu_georutex_root"
              action="action_transport_dashboard"
              groups="uta_transport_monitor.group_transport_manager,uta_transport_monitor.group_transport_analyst"
              sequence="5"/>

    <!-- 1. Operaciones -->
    <menuitem id="menu_georutex_operations"
              name="Operaciones"
              parent="menu_georutex_root"
              sequence="10"/>

    <!-- Client action for Live Fleet Map (RF-16) -->
    <record id="action_transport_live_fleet_map" model="ir.actions.client">
        <field name="name">Mapa en vivo</field>
        <field name="tag">uta_transport_live_fleet_map</field>
        <field name="target">main</field>
    </record>

    <menuitem id="menu_georutex_my_trips"
              name="Mis recorridos"
              parent="menu_georutex_operations"
              action="action_transport_trip_my_driver"
              groups="uta_transport_monitor.group_transport_driver"
              sequence="3"/>

    <menuitem id="menu_georutex_live_fleet_map"
              name="Mapa en vivo"
              parent="menu_georutex_operations"
              action="action_transport_live_fleet_map"
              sequence="5"/>

    <menuitem id="menu_georutex_trips"
              name="Recorridos"
              parent="menu_georutex_operations"
              action="action_transport_trip"
              groups="uta_transport_monitor.group_transport_manager,uta_transport_monitor.group_transport_analyst"
              sequence="10"/>

    <menuitem id="menu_georutex_incidents"
              name="Incidencias"
              parent="menu_georutex_operations"
              action="action_transport_incident"
              sequence="20"/>

    <menuitem id="menu_georutex_evaluations"
              name="Evaluaciones"
              parent="menu_georutex_operations"
              action="action_transport_trip_evaluation"
              groups="uta_transport_monitor.group_transport_manager,uta_transport_monitor.group_transport_analyst"
              sequence="25"/>

    <!-- 2. Rutas y flota -->
    <menuitem id="menu_georutex_routes_cat"
              name="Rutas y flota"
              parent="menu_georutex_root"
              groups="uta_transport_monitor.group_transport_manager,uta_transport_monitor.group_transport_analyst"
              sequence="20"/>

    <menuitem id="menu_georutex_routes"
              name="Rutas"
              parent="menu_georutex_routes_cat"
              action="action_transport_route"
              sequence="10"/>


    <menuitem id="menu_georutex_fleet"
              name="Vehículos"
              parent="menu_georutex_routes_cat"
              action="action_transport_monitored_fleet"
              sequence="30"/>

    <!-- 3. Telemetría GPS -->
    <menuitem id="menu_georutex_monitoring"
              name="Telemetría GPS"
              parent="menu_georutex_root"
              groups="uta_transport_monitor.group_transport_manager,uta_transport_monitor.group_transport_analyst"
              sequence="30"/>

    <menuitem id="menu_georutex_positions"
              name="Historial GPS"
              parent="menu_georutex_monitoring"
              action="action_transport_vehicle_position"
              sequence="10"/>
</odoo>
