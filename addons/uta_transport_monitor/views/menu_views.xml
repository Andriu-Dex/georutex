<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Root Menu: GeoRutex -->
    <menuitem id="menu_georutex_root"
              name="GeoRutex"
              web_icon="fleet,static/description/icon.png"
              sequence="10"/>

    <!-- 1. Operaciones -->
    <menuitem id="menu_georutex_operations"
              name="Operaciones"
              parent="menu_georutex_root"
              sequence="10"/>

    <!-- Client action for Live Fleet Map (RF-16) -->
    <record id="action_transport_live_fleet_map" model="ir.actions.client">
        <field name="name">Mapa en Vivo de Flota</field>
        <field name="tag">uta_transport_live_fleet_map</field>
        <field name="target">main</field>
    </record>

    <menuitem id="menu_georutex_live_fleet_map"
              name="Mapa en Vivo"
              parent="menu_georutex_operations"
              action="action_transport_live_fleet_map"
              sequence="5"/>

    <menuitem id="menu_georutex_trips"
              name="Recorridos Operacionales"
              parent="menu_georutex_operations"
              action="action_transport_trip"
              groups="uta_transport_monitor.group_transport_manager,uta_transport_monitor.group_transport_analyst"
              sequence="10"/>

    <menuitem id="menu_georutex_my_trips"
              name="Mis Recorridos"
              parent="menu_georutex_operations"
              action="action_transport_trip_my_driver"
              groups="uta_transport_monitor.group_transport_driver"
              sequence="15"/>

    <!-- 2. Catálogos y Rutas -->
    <menuitem id="menu_georutex_routes_cat"
              name="Rutas y Flota"
              parent="menu_georutex_root"
              groups="uta_transport_monitor.group_transport_manager,uta_transport_monitor.group_transport_analyst"
              sequence="20"/>

    <menuitem id="menu_georutex_routes"
              name="Rutas"
              parent="menu_georutex_routes_cat"
              action="action_transport_route"
              sequence="10"/>

    <menuitem id="menu_georutex_route_versions"
              name="Versiones de Ruta"
              parent="menu_georutex_routes_cat"
              action="action_transport_route_version"
              sequence="20"/>

    <menuitem id="menu_georutex_fleet"
              name="Vehículos Monitoreados"
              parent="menu_georutex_routes_cat"
              action="action_transport_monitored_fleet"
              sequence="30"/>

    <!-- 3. Monitoreo y Telemetría -->
    <menuitem id="menu_georutex_monitoring"
              name="Telemetría GPS"
              parent="menu_georutex_root"
              groups="uta_transport_monitor.group_transport_manager,uta_transport_monitor.group_transport_analyst"
              sequence="30"/>

    <menuitem id="menu_georutex_positions"
              name="Historial de Posiciones"
              parent="menu_georutex_monitoring"
              action="action_transport_vehicle_position"
              sequence="10"/>
</odoo>
