<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="georutex_auth_brand" name="GeoRutex authentication branding">
        <section class="georutex-auth-brand" aria-label="GeoRutex">
            <div class="georutex-orb georutex-orb-1" aria-hidden="true"/>
            <div class="georutex-orb georutex-orb-2" aria-hidden="true"/>
            <div class="georutex-brand-content">
                <header class="georutex-brand-header">
                    <span class="georutex-brand-logo-wrap">
                        <img
                            class="georutex-brand-logo"
                            src="/uta_transport_monitor/static/src/img/georutex_logo.png"
                            alt="Logo oficial GeoRutex"
                        />
                        <span class="georutex-logo-ring" aria-hidden="true"/>
                    </span>
                    <span>
                        <strong>GeoRutex</strong>
                        <small>Universidad Técnica de Ambato · Monitoreo GPS Universitario</small>
                    </span>
                </header>

                <div class="georutex-status-pill">
                    <span class="georutex-live-dot" aria-hidden="true"/>
                    <span>Plataforma de Rastreo y Evaluación en Vivo</span>
                </div>

                <div class="georutex-login-visual">
                    <img
                        class="georutex-login-map"
                        src="/uta_transport_monitor/static/src/img/mapa.webp"
                        alt="Mapa urbano con rutas y ubicaciones de vehículos"
                    />
                    <img
                        class="georutex-login-phone"
                        src="/uta_transport_monitor/static/src/img/celular.webp"
                        alt="Teléfono móvil con la ruta de un bus"
                    />
                </div>

                <div class="georutex-brand-message">
                    <h1>Control inteligente de rutas, paradas y puntualidad universitaria</h1>
                    <ul>
                        <li>Telemetría Traccar GPS</li>
                        <li>Reportes de incidencias</li>
                        <li>Seguridad UTA</li>
                    </ul>
                </div>
            </div>
            <script type="text/javascript" defer="defer" src="/uta_transport_monitor/static/src/js/georutex_auth_validation.js?v=16.0.6.6"/>
        </section>
    </template>

    <template id="georutex_password_meter" name="GeoRutex password strength meter">
        <div class="georutex-password-meter" aria-live="polite">
            <div class="georutex-meter-header">
                <span>Seguridad de la contraseña</span>
                <span class="georutex-meter-label">Sin ingresar</span>
            </div>
            <div class="progress">
                <div class="progress-bar bg-danger" role="progressbar" style="width: 0%"/>
            </div>
            <ul class="georutex-pwd-rules">
                <li data-rule="min-length"><i class="fa fa-circle-o" aria-hidden="true"/> 8+ caracteres (sin espacios)</li>
                <li data-rule="upper"><i class="fa fa-circle-o" aria-hidden="true"/> Una letra mayúscula</li>
                <li data-rule="lower"><i class="fa fa-circle-o" aria-hidden="true"/> Una letra minúscula</li>
                <li data-rule="digit"><i class="fa fa-circle-o" aria-hidden="true"/> Al menos un número</li>
                <li data-rule="special"><i class="fa fa-circle-o" aria-hidden="true"/> Un carácter especial (!@#$%)</li>
            </ul>
        </div>
    </template>

    <!-- Login principal: /georutex/acceso -->
    <template id="georutex_login_brand" inherit_id="web.login" name="GeoRutex login">
        <xpath expr="//form[hasclass('oe_login_form')]" position="attributes">
            <attribute name="t-attf-action">/georutex/acceso</attribute>
            <attribute name="novalidate">novalidate</attribute>
        </xpath>
        <xpath expr="//form[hasclass('oe_login_form')]" position="before">
            <t t-call="uta_transport_monitor.georutex_auth_brand"/>
            <div class="georutex-auth-heading">
                <div class="georutex-auth-head-row">
                    <img
                        class="georutex-mini-logo"
                        src="/uta_transport_monitor/static/src/img/georutex_logo.png"
                        alt="GeoRutex"
                    />
                    <span class="georutex-auth-pill">
                        <i class="fa fa-shield" aria-hidden="true"/> Acceso GeoRutex
                    </span>
                </div>
                <h2>Iniciar sesión</h2>
                <p>Ingresa con tu correo verificado para acceder a tu espacio operativo.</p>
            </div>
            <div t-if="georutex_verify_url" class="alert alert-info d-flex flex-column gap-2 mb-3" role="alert">
                <span><i class="fa fa-envelope-o me-1" aria-hidden="true"/> Completa la verificación numérica de tu correo para activar tu cuenta.</span>
                <a t-att-href="georutex_verify_url" class="btn btn-sm btn-primary align-self-start">
                    Ingresar código de 6 dígitos
                </a>
            </div>
        </xpath>

        <xpath expr="//label[@for='db']" position="replace">
            <label for="db" class="col-form-label">Base de datos</label>
        </xpath>
        <xpath expr="//a[@href='/web/database/selector']" position="replace">
            <a role="button" href="/web/database/selector" class="btn btn-secondary">Seleccionar <i class="fa fa-database" role="img" aria-label="Base de datos" title="Base de datos"/></a>
        </xpath>
        <xpath expr="//label[@for='login']" position="replace">
            <label for="login" class="form-label">Correo electrónico</label>
        </xpath>
        <xpath expr="//input[@id='login']" position="attributes">
            <attribute name="placeholder">ejemplo@gmail.com</attribute>
            <attribute name="autocomplete">username</attribute>
        </xpath>
        <xpath expr="//label[@for='password']" position="replace">
            <label for="password" class="form-label">Contraseña</label>
        </xpath>
        <xpath expr="//input[@id='password']" position="attributes">
            <attribute name="placeholder">Ingresa tu contraseña</attribute>
            <attribute name="autocomplete">current-password</attribute>
        </xpath>
        <xpath expr="//form[hasclass('oe_login_form')]//button[@type='submit'][not(@name)]" position="replace">
            <button type="submit" class="btn btn-primary w-100 georutex-cta-btn">
                <i class="fa fa-sign-in me-2" aria-hidden="true"/>INICIAR SESIÓN
            </button>
        </xpath>
    </template>

    <template id="georutex_login_signup_labels" inherit_id="auth_signup.login" name="GeoRutex login links">
        <xpath expr="//a[@t-if='signup_enabled']" position="replace">
            <a t-if="signup_enabled" t-attf-href="/georutex/registro-conductor?{{ keep_query() }}" class="fw-semibold">Crear cuenta de conductor</a>
        </xpath>
        <xpath expr="//a[@t-if='reset_password_enabled']" position="replace">
            <a t-if="reset_password_enabled" t-attf-href="/georutex/recuperar-acceso?{{ keep_query() }}">¿Olvidaste tu contraseña?</a>
        </xpath>
    </template>

    <template id="georutex_login_layout_labels" inherit_id="web.login_layout" name="GeoRutex login layout">
        <xpath expr="//a[@href='/web/database/manager']" position="replace">
            <a class="border-end pe-2 me-1" href="/web/database/manager">Administrar bases de datos</a>
        </xpath>
    </template>

    <!-- Registro de conductor: /georutex/registro-conductor -->
    <template id="georutex_signup_brand" inherit_id="auth_signup.signup" name="GeoRutex signup">
        <xpath expr="//form[hasclass('oe_signup_form')]" position="attributes">
            <attribute name="t-attf-action">/georutex/registro-conductor</attribute>
            <attribute name="novalidate">novalidate</attribute>
        </xpath>
        <xpath expr="//form[hasclass('oe_signup_form')]" position="before">
            <t t-call="uta_transport_monitor.georutex_auth_brand"/>
            <div class="georutex-auth-heading is-centered">
                <div class="georutex-auth-head-row justify-content-center">
                    <span class="georutex-auth-pill">
                        <i class="fa fa-bus" aria-hidden="true"/> Registro de Conductor
                    </span>
                </div>
                <h2 class="georutex-dynamic-title">
                    <span>Crear cuenta</span>
                </h2>
            </div>
        </xpath>
        <xpath expr="//form[hasclass('oe_signup_form')]//button[@type='submit']" position="replace">
            <button type="submit" class="btn btn-primary w-100 georutex-cta-btn">
                <i class="fa fa-paper-plane me-2" aria-hidden="true"/>CONTINUAR Y VERIFICAR CORREO
            </button>
        </xpath>
        <xpath expr="//form[hasclass('oe_signup_form')]//a[@role='button']" position="replace">
            <div class="georutex-auth-footer">
                ¿Ya tienes una cuenta?
                <a t-attf-href="/georutex/acceso?{{ keep_query() }}" role="button">Inicia sesión aquí</a>
            </div>
        </xpath>
    </template>

    <template id="georutex_signup_field_labels" inherit_id="auth_signup.fields" name="GeoRutex signup field labels">
        <xpath expr="//label[@for='login']" position="replace">
            <label for="login" class="form-label">Correo electrónico</label>
        </xpath>
        <xpath expr="//input[@id='login']" position="attributes">
            <attribute name="placeholder">ejemplo@gmail.com</attribute>
            <attribute name="type">email</attribute>
            <attribute name="autocomplete">email</attribute>
        </xpath>
        <xpath expr="//label[@for='name']" position="replace">
            <label for="name" class="form-label">Nombre y apellido</label>
        </xpath>
        <xpath expr="//input[@id='name']" position="attributes">
            <attribute name="placeholder">Ej. Juan Pérez</attribute>
            <attribute name="autocomplete">name</attribute>
        </xpath>
        <xpath expr="//input[@id='name']" position="after">
            <div class="form-text text-muted small">Solo letras y espacios; cada palabra debe iniciar con mayúscula.</div>
        </xpath>
        <xpath expr="//label[@for='password']" position="replace">
            <label for="password" class="form-label">Contraseña segura</label>
        </xpath>
        <xpath expr="//input[@id='password']" position="attributes">
            <attribute name="placeholder">Mínimo 8 caracteres seguros</attribute>
            <attribute name="autocomplete">new-password</attribute>
        </xpath>
        <xpath expr="//input[@id='password']" position="after">
            <t t-call="uta_transport_monitor.georutex_password_meter"/>
        </xpath>
        <xpath expr="//label[@for='confirm_password']" position="replace">
            <label for="confirm_password" class="form-label">Confirmar contraseña</label>
        </xpath>
        <xpath expr="//input[@id='confirm_password']" position="attributes">
            <attribute name="placeholder">Repite tu contraseña</attribute>
            <attribute name="autocomplete">new-password</attribute>
        </xpath>
    </template>

    <!-- Recuperación de acceso: /georutex/recuperar-acceso -->
    <template id="georutex_reset_password_brand" inherit_id="auth_signup.reset_password" name="GeoRutex reset password">
        <xpath expr="//form[hasclass('oe_reset_password_form')]" position="attributes">
            <attribute name="novalidate">novalidate</attribute>
        </xpath>
        <xpath expr="//form[hasclass('oe_reset_password_form')]" position="before">
            <t t-call="uta_transport_monitor.georutex_auth_brand"/>
            <div class="georutex-auth-heading">
                <div class="georutex-auth-head-row">
                    <img
                        class="georutex-mini-logo"
                        src="/uta_transport_monitor/static/src/img/georutex_logo.png"
                        alt="GeoRutex"
                    />
                    <span class="georutex-auth-pill">
                        <i class="fa fa-key" aria-hidden="true"/> Recuperación
                    </span>
                </div>
                <h2>Recuperar acceso</h2>
                <p>Ingresa el correo registrado en tu cuenta para restablecer tu contraseña.</p>
            </div>
        </xpath>
        <xpath expr="//form[hasclass('oe_reset_password_form')]//a[contains(@t-attf-href, '/web/login')]" position="replace">
            <a t-attf-href="/georutex/acceso?{{ keep_query() }}">Volver a iniciar sesión</a>
        </xpath>
    </template>

    <!-- Verificación numérica de correo (OTP 6 dígitos): /georutex/verificar-correo -->
    <template id="georutex_verify_email" name="GeoRutex 6-Digit Email Verification">
        <t t-call="web.login_layout">
            <t t-call="uta_transport_monitor.georutex_auth_brand"/>
            <div class="georutex-otp-wrapper">
                <div class="georutex-auth-heading">
                    <div class="georutex-auth-head-row">
                        <img
                            class="georutex-mini-logo"
                            src="/uta_transport_monitor/static/src/img/georutex_logo.png"
                            alt="GeoRutex"
                        />
                        <span class="georutex-auth-pill">
                            <i class="fa fa-envelope-open-o" aria-hidden="true"/> Verificación de Correo
                        </span>
                    </div>
                    <h2>Verifica tu correo electrónico</h2>
                    <p>
                        Ingresa el <strong>código numérico de 6 dígitos</strong> enviado a
                        <strong t-out="masked_email or email"/>.
                    </p>
                </div>

                <div t-if="delivery_status == 'sent'" class="alert alert-primary d-flex align-items-start gap-2" role="status">
                    <i class="fa fa-paper-plane mt-1" aria-hidden="true"/>
                    <div>
                        <strong t-if="resent">Nuevo código enviado.</strong>
                        <strong t-else="">Correo enviado por SMTP.</strong>
                        Revisa tu bandeja de entrada o carpeta de spam. El código vence en 10 minutos.
                    </div>
                </div>

                <div t-elif="delivery_status == 'smtp_not_configured'" class="alert alert-warning d-flex align-items-start gap-2" role="alert">
                    <i class="fa fa-exclamation-triangle mt-1" aria-hidden="true"/>
                    <div>
                        <strong>Servidor SMTP no configurado en Odoo.</strong>
                        Configura <code>SMTP_HOST</code>, <code>SMTP_USER</code>, <code>SMTP_PASSWORD</code> y <code>SMTP_FROM</code> en <code>.env</code> (o en Ajustes → Servidores de correo saliente) y presiona <strong>Reenviar código</strong>.
                    </div>
                </div>

                <div t-elif="delivery_status == 'failed'" class="alert alert-danger d-flex align-items-start gap-2" role="alert">
                    <i class="fa fa-times-circle mt-1" aria-hidden="true"/>
                    <div>
                        <strong>Error al enviar el correo por SMTP.</strong>
                        Verifica las credenciales del servidor saliente e intenta reenviar el código.
                    </div>
                </div>

                <div t-if="error" class="alert alert-danger georutex-shake" role="alert">
                    <i class="fa fa-exclamation-circle me-1" aria-hidden="true"/>
                    <t t-out="error"/>
                </div>

                <form class="georutex-otp-form" action="/georutex/verificar-correo" method="post" novalidate="novalidate">
                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                    <input type="hidden" name="email" t-att-value="email"/>
                    <input type="hidden" name="code" id="georutex_otp_hidden" value=""/>

                    <label class="form-label d-block text-center mb-2">Código numérico de 6 dígitos</label>
                    <div class="georutex-otp-grid" role="group" aria-label="Código numérico de 6 dígitos">
                        <input type="text" inputmode="numeric" pattern="[0-9]*" maxlength="1" name="digit_1" class="form-control georutex-otp-digit" autocomplete="one-time-code" aria-label="Dígito 1" required="required"/>
                        <input type="text" inputmode="numeric" pattern="[0-9]*" maxlength="1" name="digit_2" class="form-control georutex-otp-digit" aria-label="Dígito 2" required="required"/>
                        <input type="text" inputmode="numeric" pattern="[0-9]*" maxlength="1" name="digit_3" class="form-control georutex-otp-digit" aria-label="Dígito 3" required="required"/>
                        <input type="text" inputmode="numeric" pattern="[0-9]*" maxlength="1" name="digit_4" class="form-control georutex-otp-digit" aria-label="Dígito 4" required="required"/>
                        <input type="text" inputmode="numeric" pattern="[0-9]*" maxlength="1" name="digit_5" class="form-control georutex-otp-digit" aria-label="Dígito 5" required="required"/>
                        <input type="text" inputmode="numeric" pattern="[0-9]*" maxlength="1" name="digit_6" class="form-control georutex-otp-digit" aria-label="Dígito 6" required="required"/>
                    </div>

                    <div class="d-grid mt-4">
                        <button type="submit" class="btn btn-primary georutex-cta-btn">
                            <i class="fa fa-check-circle me-2" aria-hidden="true"/>VERIFICAR Y ACTIVAR CUENTA
                        </button>
                    </div>
                </form>

                <form action="/georutex/reenviar-codigo" method="post" class="text-center mt-3">
                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                    <input type="hidden" name="email" t-att-value="email"/>
                    <span class="small text-muted me-1">¿No recibiste el correo?</span>
                    <button type="submit" class="btn btn-link btn-sm p-0 fw-semibold">
                        Reenviar código numérico
                    </button>
                </form>

                <div class="georutex-auth-footer">
                    <a href="/georutex/acceso">
                        <i class="fa fa-arrow-left me-1" aria-hidden="true"/>Volver a iniciar sesión
                    </a>
                </div>
            </div>
        </t>
    </template>
</odoo>
