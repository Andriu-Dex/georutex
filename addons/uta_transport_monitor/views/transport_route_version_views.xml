<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tree View: Versiones de Ruta -->
    <record id="view_transport_route_version_tree" model="ir.ui.view">
        <field name="name">transport.route.version.tree</field>
        <field name="model">transport.route.version</field>
        <field name="arch" type="xml">
            <tree string="Versiones de Ruta" decoration-info="state == 'draft'" decoration-success="state == 'approved'" decoration-muted="state == 'archived'">
                <field name="route_id"/>
                <field name="version_number"/>
                <field name="name"/>
                <field name="state" widget="badge" decoration-info="state == 'draft'" decoration-success="state == 'approved'" decoration-muted="state == 'archived'"/>
                <field name="stop_count"/>
                <field name="estimated_distance_m"/>
                <field name="planned_duration_display"/>
                <field name="lateness_tolerance_s"/>
                <field name="route_corridor_m"/>
                <field name="active_for_new_trips" widget="boolean_toggle"/>
            </tree>
        </field>
    </record>

    <!-- Form View: Versiones de Ruta -->
    <record id="view_transport_route_version_form" model="ir.ui.view">
        <field name="name">transport.route.version.form</field>
        <field name="model">transport.route.version</field>
        <field name="arch" type="xml">
            <form string="Versión de Ruta">
                <header>
                    <button name="action_approve" string="Aprobar Versión" type="object" class="oe_highlight" attrs="{'invisible': [('state', '!=', 'draft')]}"/>
                    <button name="action_calculate_road_route" string="Calcular Trazado Vial" type="object" class="btn-primary" attrs="{'invisible': [('state', '!=', 'draft')]}"/>
                    <button name="action_auto_classify_stops" string="Auto-clasificar Paradas" type="object" class="btn-secondary" attrs="{'invisible': [('state', '!=', 'draft')]}"/>
                    <button name="action_compute_distance_from_polyline" string="Recalcular Distancia" type="object" class="btn-secondary" attrs="{'invisible': [('state', '!=', 'draft')]}"/>
                    <button name="action_archive" string="Archivar" type="object" attrs="{'invisible': [('state', '!=', 'approved')]}"/>
                    <button name="action_set_to_draft" string="Revertir a Borrador" type="object" attrs="{'invisible': [('state', '!=', 'archived')]}"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,approved,archived"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Aprobada" bg_color="bg-success" attrs="{'invisible': [('state', '!=', 'approved')]}"/>
                    <widget name="web_ribbon" title="Archivada" bg_color="bg-secondary" attrs="{'invisible': [('state', '!=', 'archived')]}"/>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" icon="fa-map-marker">
                            <field name="stop_count" widget="statinfo" string="Puntos de Control"/>
                        </button>
                        <button class="oe_stat_button" icon="fa-road">
                            <field name="trip_count" widget="statinfo" string="Recorridos"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="route_id" class="oe_edit_only" string="Ruta"/>
                        <h1>
                            <field name="route_id" options="{'no_create': True}" attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                        </h1>
                        <h3>
                            <span>Versión Nº </span>
                            <field name="version_number" class="oe_inline" attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                        </h3>
                    </div>
                    <group>
                        <group string="Parámetros Canónicos de Tolerancia (Sección 7.1)">
                            <field name="stop_radius_m" attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                            <field name="route_corridor_m" attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                            <field name="lateness_tolerance_s" attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                            <field name="gps_gap_threshold_s" attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                        </group>
                        <group string="Métricas de Geometría y Operación">
                            <field name="estimated_distance_m"/>
                            <field name="planned_duration_display" readonly="1"/>
                            <field name="minimum_consecutive_deviation_points" attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                            <field name="minimum_deviation_duration_s" attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                            <field name="geo_accuracy_max_m" attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Editor Visual de Ruta" name="visual_editor_page">
                            <field name="id" widget="route_editor_widget" nolabel="1"/>
                        </page>
                        <page string="Puntos de Control y Paradas" name="stops_page">
                            <div class="mb-2" attrs="{'invisible': [('state', '!=', 'draft')]}">
                                <button name="action_auto_classify_stops" string="Auto-clasificar Paradas" type="object" class="btn btn-sm btn-outline-primary me-2" icon="fa-magic"/>
                                <button name="action_calculate_road_route" string="Calcular Trazado Vial" type="object" class="btn btn-sm btn-outline-info" icon="fa-road"/>
                            </div>
                            <field name="stop_ids" attrs="{'readonly': [('state', '!=', 'draft')]}">
                                <tree editable="bottom" string="Paradas y Puntos de Control">
                                    <field name="sequence" widget="handle"/>
                                    <field name="sequence"/>
                                    <field name="name"/>
                                    <field name="stop_type"/>
                                    <field name="latitude"/>
                                    <field name="longitude"/>
                                    <field name="radius_m"/>
                                    <field name="planned_offset_minutes" string="Tiempo Previsto (min)"/>
                                    <field name="planned_offset_display" string="Legible" optional="show"/>
                                    <field name="planned_offset_seconds" string="Segundos" optional="hide"/>
                                    <field name="required" widget="boolean_toggle"/>
                                    <field name="notes" optional="hide"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Geometría GeoJSON de Referencia" name="geometry_page">
                            <group>
                                <field name="reference_polyline" widget="ace" options="{'mode': 'json'}" placeholder="[[ -78.627, -1.261 ], [ -78.625, -1.258 ], ...]" attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                            </group>
                        </page>
                        <page string="Aprobación y Auditoría" name="audit_page">
                            <group>
                                <group>
                                    <field name="approved_at"/>
                                    <field name="approved_by_id"/>
                                </group>
                                <group>
                                    <field name="active_for_new_trips" widget="boolean_toggle"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Search View: Versiones de Ruta -->
    <record id="view_transport_route_version_search" model="ir.ui.view">
        <field name="name">transport.route.version.search</field>
        <field name="model">transport.route.version</field>
        <field name="arch" type="xml">
            <search string="Buscar Versiones">
                <field name="route_id"/>
                <field name="version_number"/>
                <separator/>
                <filter string="Borradores" name="filter_draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Aprobadas" name="filter_approved" domain="[('state', '=', 'approved')]"/>
                <filter string="Archivadas" name="filter_archived" domain="[('state', '=', 'archived')]"/>
                <group expand="0" string="Agrupar Por">
                    <filter string="Ruta" name="group_route" context="{'group_by': 'route_id'}"/>
                    <filter string="Estado" name="group_state" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action Window: Versiones de Ruta -->
    <record id="action_transport_route_version" model="ir.actions.act_window">
        <field name="name">Versiones de Ruta</field>
        <field name="res_model">transport.route.version</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_transport_route_version_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Crea una versión de trazado y parámetros para una ruta
            </p>
            <p>
                Cada versión define parámetros canónicos congelables (radio de parada, corredor, tolerancias) y sus puntos de control secuenciales (RF-14).
            </p>
        </field>
    </record>
</odoo>

