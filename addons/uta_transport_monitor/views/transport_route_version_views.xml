<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tree View: Versiones de Ruta -->
    <record id="view_transport_route_version_tree" model="ir.ui.view">
        <field name="name">transport.route.version.tree</field>
        <field name="model">transport.route.version</field>
        <field name="arch" type="xml">
            <tree string="Versiones de Ruta" decoration-info="state == 'draft'" decoration-success="state == 'approved'" decoration-muted="state == 'archived'">
                <field name="route_id"/>
                <field name="version_number"/>
                <field name="name"/>
                <field name="state" widget="badge" decoration-info="state == 'draft'" decoration-success="state == 'approved'" decoration-muted="state == 'archived'"/>
                <field name="stop_count"/>
                <field name="estimated_distance_m"/>
                <field name="planned_duration_display"/>
                <field name="lateness_tolerance_s"/>
                <field name="route_corridor_m"/>
                <field name="active_for_new_trips" widget="boolean_toggle"/>
            </tree>
        </field>
    </record>

    <!-- Form View: Versiones de Ruta -->
    <record id="view_transport_route_version_form" model="ir.ui.view">
        <field name="name">transport.route.version.form</field>
        <field name="model">transport.route.version</field>
        <field name="arch" type="xml">
            <form string="Paradas y trazado de la ruta">
                <header>
                    <button name="action_approve" string="Aprobar versión" type="object" class="oe_highlight" icon="fa-check" attrs="{'invisible': [('state', '!=', 'draft')]}"/>
                    <button name="action_calculate_road_route" string="Calcular trazado vial" type="object" class="btn-secondary" icon="fa-road" attrs="{'invisible': [('state', '!=', 'draft')]}"/>
                    <button name="action_archive" string="Archivar" type="object" confirm="¿Archivar esta versión? Ya no se podrá usar en nuevos recorridos." attrs="{'invisible': [('state', '!=', 'approved')]}"/>
                    <button name="action_set_to_draft" string="Volver a borrador" type="object" attrs="{'invisible': [('state', '!=', 'archived')]}"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,approved,archived"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Aprobada" bg_color="bg-success" attrs="{'invisible': [('state', '!=', 'approved')]}"/>
                    <widget name="web_ribbon" title="Archivada" bg_color="bg-secondary" attrs="{'invisible': [('state', '!=', 'archived')]}"/>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" icon="fa-map-marker">
                            <field name="stop_count" widget="statinfo" string="Paradas"/>
                        </button>
                        <button class="oe_stat_button" icon="fa-road">
                            <field name="trip_count" widget="statinfo" string="Recorridos"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="route_id" class="oe_edit_only" string="Ruta"/>
                        <h1>
                            <field name="route_id" options="{'no_create': True}" attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                        </h1>
                        <h3>
                            <span>Versión </span>
                            <field name="version_number" class="oe_inline" attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                        </h3>
                    </div>
                    <div class="alert alert-info mb-3" role="status" attrs="{'invisible': [('state', '!=', 'draft')]}">
                        <strong>Cómo preparar la ruta:</strong>
                        <ol class="mb-0 mt-1">
                            <li>Agregue las paradas en el mapa o en la pestaña «Paradas»: un origen, un destino y al menos dos controles intermedios.</li>
                            <li>Pulse «Calcular trazado vial» para obtener el recorrido por las calles.</li>
                            <li>Pulse «Aprobar versión». Desde ese momento la ruta queda disponible para programar recorridos y ya no se puede modificar.</li>
                        </ol>
                    </div>
                    <group>
                        <group string="Tolerancias de control">
                            <field name="stop_radius_m" attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                            <field name="route_corridor_m" attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                            <field name="lateness_tolerance_s" attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                            <field name="gps_gap_threshold_s" attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                        </group>
                        <group string="Resumen">
                            <field name="estimated_distance_m"/>
                            <field name="planned_duration_display" readonly="1"/>
                            <field name="approved_at" attrs="{'invisible': [('approved_at', '=', False)]}"/>
                            <field name="approved_by_id" attrs="{'invisible': [('approved_by_id', '=', False)]}"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Mapa de la ruta" name="visual_editor_page">
                            <field name="id" widget="route_editor_widget" nolabel="1"/>
                        </page>
                        <page string="Paradas" name="stops_page">
                            <div class="mb-2" attrs="{'invisible': [('state', '!=', 'draft')]}">
                                <button name="action_auto_classify_stops" string="Asignar tipos automáticamente" type="object" class="btn btn-sm btn-outline-primary" icon="fa-magic"
                                        help="Marca la primera parada como origen, la última como destino y las demás como controles intermedios."/>
                            </div>
                            <field name="stop_ids" attrs="{'readonly': [('state', '!=', 'draft')]}">
                                <tree editable="bottom" string="Paradas">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="stop_type"/>
                                    <field name="planned_offset_minutes" string="Minutos desde la salida"/>
                                    <field name="planned_offset_display" string="Tiempo previsto" optional="hide"/>
                                    <field name="required" widget="boolean_toggle"/>
                                    <field name="radius_m" optional="hide"/>
                                    <field name="latitude" optional="hide"/>
                                    <field name="longitude" optional="hide"/>
                                    <field name="planned_offset_seconds" string="Segundos" optional="hide"/>
                                    <field name="notes" optional="hide"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Configuración avanzada" name="advanced_page">
                            <group>
                                <group string="Detección de desvíos">
                                    <field name="minimum_consecutive_deviation_points" attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                                    <field name="minimum_deviation_duration_s" attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                                    <field name="geo_accuracy_max_m" attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                                </group>
                                <group string="Uso">
                                    <field name="active_for_new_trips" widget="boolean_toggle"/>
                                    <button name="action_compute_distance_from_polyline" string="Recalcular distancia" type="object" class="btn btn-sm btn-outline-secondary" colspan="2" attrs="{'invisible': [('state', '!=', 'draft')]}"/>
                                </group>
                            </group>
                            <separator string="Trazado de referencia (coordenadas)"/>
                            <field name="reference_polyline" widget="ace" options="{'mode': 'json'}" attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Search View: Versiones de Ruta -->
    <record id="view_transport_route_version_search" model="ir.ui.view">
        <field name="name">transport.route.version.search</field>
        <field name="model">transport.route.version</field>
        <field name="arch" type="xml">
            <search string="Buscar Versiones">
                <field name="route_id"/>
                <field name="version_number"/>
                <separator/>
                <filter string="Borradores" name="filter_draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Aprobadas" name="filter_approved" domain="[('state', '=', 'approved')]"/>
                <filter string="Archivadas" name="filter_archived" domain="[('state', '=', 'archived')]"/>
                <group expand="0" string="Agrupar Por">
                    <filter string="Ruta" name="group_route" context="{'group_by': 'route_id'}"/>
                    <filter string="Estado" name="group_state" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action Window: Versiones de Ruta -->
    <record id="action_transport_route_version" model="ir.actions.act_window">
        <field name="name">Versiones de Ruta</field>
        <field name="res_model">transport.route.version</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_transport_route_version_search"/>
        <field name="help" type="html">
            <div class="grx-nocontent">
                <div class="grx-nocontent-icon grx-nc-route"/>
                <h3>Sin versiones de ruta</h3>
                <p>Crea una versión de trazado con sus paradas y parámetros de evaluación para habilitar recorridos.</p>
            </div>
        </field>
    </record>
</odoo>

