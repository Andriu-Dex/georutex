<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tree View: Recorridos -->
    <record id="view_transport_trip_tree" model="ir.ui.view">
        <field name="name">transport.trip.tree</field>
        <field name="model">transport.trip</field>
        <field name="arch" type="xml">
            <tree string="Recorridos Operacionales">
                <field name="route_id" string="Ruta"/>
                <field name="name" string="Código"/>
                <field name="scheduled_start_utc" string="Inicio programado"/>
                <field name="scheduled_end_utc" string="Fin previsto"/>
                <field name="scheduled_duration_display" string="Duración" optional="hide"/>
                <field name="vehicle_id" string="Unidad"/>
                <field name="driver_id" string="Conductor"/>
                <field name="route_version_id" string="Versión" optional="hide"/>
                <field name="source_type" string="Fuente" widget="badge" decoration-warning="source_type == 'simulated'" decoration-info="source_type == 'real'"/>
                <field name="evaluation_status" string="Evaluación" widget="badge" decoration-success="evaluation_status == 'compliant'" decoration-danger="evaluation_status == 'non_compliant'" decoration-warning="evaluation_status == 'indeterminate'" decoration-info="evaluation_status == 'unevaluated'"/>
                <field name="state" string="Estado" widget="badge" decoration-info="state == 'draft'" decoration-primary="state == 'scheduled'" decoration-warning="state == 'in_progress'" decoration-success="state == 'completed'" decoration-muted="state == 'cancelled'"/>
            </tree>
        </field>
    </record>

    <!-- Dedicated Driver Agenda List View: Mis Recorridos (No redundant driver column) -->
    <record id="view_transport_trip_driver_tree" model="ir.ui.view">
        <field name="name">transport.trip.driver.tree</field>
        <field name="model">transport.trip</field>
        <field name="priority">25</field>
        <field name="arch" type="xml">
            <tree string="Mis recorridos">
                <field name="route_id" string="Ruta"/>
                <field name="scheduled_start_utc" string="Fecha y salida"/>
                <field name="scheduled_end_utc" string="Llegada prevista"/>
                <field name="vehicle_id" string="Unidad asignada"/>
                <field name="state" string="Estado" widget="badge" decoration-info="state == 'draft'" decoration-primary="state == 'scheduled'" decoration-warning="state == 'in_progress'" decoration-success="state == 'completed'" decoration-muted="state == 'cancelled'"/>
                <field name="name" string="Código" optional="show"/>
            </tree>
        </field>
    </record>

    <!-- Kanban View: Recorridos (Home moderno del Conductor, Bootstrap 5 + SCSS) -->
    <record id="view_transport_trip_kanban" model="ir.ui.view">
        <field name="name">transport.trip.kanban</field>
        <field name="model">transport.trip</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" class="o_kanban_mobile o_georutex_driver_kanban">
                <field name="id"/>
                <field name="name"/>
                <field name="vehicle_id"/>
                <field name="driver_id"/>
                <field name="route_id"/>
                <field name="scheduled_start_utc"/>
                <field name="scheduled_end_utc"/>
                <field name="source_type"/>
                <field name="state"/>
                <field name="position_count"/>
                <field name="incident_count"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click o_georutex_driver_trip_card">
                            <div t-attf-class="o_georutex_card_accent state-#{record.state.raw_value}"/>
                            <div class="p-3">
                                <div class="d-flex justify-content-between align-items-start gap-2 mb-2">
                                    <div>
                                        <strong class="d-block fs-5 text-dark">
                                            <field name="name"/>
                                        </strong>
                                        <span class="text-muted small d-flex align-items-center gap-1 mt-1">
                                            <i class="fa fa-road text-primary" title="Ruta"/>
                                            <field name="route_id"/>
                                        </span>
                                    </div>
                                    <span class="badge rounded-pill px-2 py-1" t-attf-class="#{record.state.raw_value == 'completed' ? 'bg-success' : (record.state.raw_value == 'in_progress' ? 'bg-warning text-dark' : (record.state.raw_value == 'scheduled' ? 'bg-primary' : 'bg-secondary'))}">
                                        <field name="state"/>
                                    </span>
                                </div>

                                <div class="o_georutex_trip_meta_grid my-2">
                                    <div class="o_georutex_trip_meta_row">
                                        <i class="fa fa-bus text-primary" title="Vehículo"/>
                                        <span><strong>Vehículo:</strong> <field name="vehicle_id"/></span>
                                    </div>
                                    <div class="o_georutex_trip_meta_row">
                                        <i class="fa fa-user text-secondary" title="Conductor"/>
                                        <span><strong>Conductor:</strong> <field name="driver_id"/></span>
                                    </div>
                                    <div class="o_georutex_trip_meta_row">
                                        <i class="fa fa-clock-o text-info" title="Horario Programado"/>
                                        <span><strong>Inicio:</strong> <field name="scheduled_start_utc"/></span>
                                    </div>
                                </div>

                                <div class="o_georutex_card_actions">
                                    <div class="d-flex align-items-center gap-2 flex-wrap">
                                        <span t-if="record.source_type.raw_value == 'simulated'" class="badge rounded-pill bg-warning text-dark">
                                            Simulado
                                        </span>
                                        <span t-else="" class="badge rounded-pill bg-info text-white">
                                            GPS Real
                                        </span>
                                        <span class="small text-muted">
                                            <i class="fa fa-map-pin me-1" title="Posiciones GPS"/><field name="position_count"/> pts
                                        </span>
                                    </div>
                                    <button t-if="record.state.raw_value == 'in_progress' or record.state.raw_value == 'scheduled'"
                                            name="action_report_incident"
                                            type="object"
                                            class="btn btn-outline-danger btn-sm o_georutex_report_btn">
                                        <i class="fa fa-exclamation-triangle me-1" aria-hidden="true"/>Reportar incidencia
                                    </button>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Form View: Recorridos -->
    <record id="view_transport_trip_form" model="ir.ui.view">
        <field name="name">transport.trip.form</field>
        <field name="model">transport.trip</field>
        <field name="arch" type="xml">
            <form string="Recorrido Operacional" class="o_georutex_trip_form">
                <header>
                    <button name="action_schedule" string="Confirmar programación" type="object" class="oe_highlight" attrs="{'invisible': [('state', '!=', 'draft')]}" groups="uta_transport_monitor.group_transport_manager"/>
                    <button name="action_start" string="Iniciar recorrido" type="object" class="oe_highlight" attrs="{'invisible': [('state', '!=', 'scheduled')]}" groups="uta_transport_monitor.group_transport_manager"/>
                    <button name="action_complete" string="Finalizar recorrido" type="object" class="btn-success" attrs="{'invisible': [('state', '!=', 'in_progress')]}" groups="uta_transport_monitor.group_transport_manager"/>
                    <button name="action_evaluate_trip" string="Evaluar recorrido" type="object" class="btn-secondary" icon="fa-check-circle" attrs="{'invisible': [('state', '!=', 'completed')]}" groups="uta_transport_monitor.group_transport_manager,uta_transport_monitor.group_transport_analyst"/>
                    <button name="action_sync_trip_gps" string="Sincronizar GPS" type="object" class="btn-secondary" icon="fa-refresh" attrs="{'invisible': [('state', 'not in', ('in_progress', 'completed'))]}" groups="uta_transport_monitor.group_transport_manager,uta_transport_monitor.group_transport_analyst"/>
                    <button name="action_cancel" string="Cancelar recorrido" type="object" confirm="¿Desea cancelar este recorrido?" attrs="{'invisible': [('state', 'in', ('completed', 'cancelled'))]}" groups="uta_transport_monitor.group_transport_manager"/>
                    <button name="action_set_to_draft" string="Volver a borrador" type="object" attrs="{'invisible': [('state', 'not in', ('scheduled', 'cancelled'))]}" groups="uta_transport_monitor.group_transport_manager"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,scheduled,in_progress,completed,cancelled"/>
                </header>
                <sheet>
                    <div class="o_georutex_trip_map_backdrop">
                        <field name="id" widget="trip_map_widget" nolabel="1"/>
                    </div>
                    <field name="id" widget="trip_form_drawer_handle" nolabel="1"/>
                    <field name="is_schedule_overdue" invisible="1"/>
                    <div class="alert alert-warning mb-3" role="alert" attrs="{'invisible': [('is_schedule_overdue', '=', False)]}">
                        <i class="fa fa-exclamation-triangle me-2" title="Alerta"/>
                        <strong>Horario vencido:</strong> la hora prevista de llegada ya pasó y el recorrido sigue <b>en curso</b>. Sincronice el GPS o finalice el recorrido cuando llegue al destino.
                    </div>
                    <widget name="web_ribbon" title="Simulado" bg_color="bg-warning" attrs="{'invisible': [('source_type', '!=', 'simulated')]}"/>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" icon="fa-map-marker">
                            <field name="stop_visit_count" widget="statinfo" string="Paradas"/>
                        </button>
                        <button class="oe_stat_button" icon="fa-location-arrow">
                            <field name="position_count" widget="statinfo" string="Posiciones GPS"/>
                        </button>
                        <button class="oe_stat_button" icon="fa-exclamation-triangle">
                            <field name="incident_count" widget="statinfo" string="Incidencias"/>
                        </button>
                        <button class="oe_stat_button" icon="fa-check-square-o">
                            <field name="evaluation_count" widget="statinfo" string="Evaluaciones"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only" string="Código del recorrido"/>
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Asignación">
                            <field name="vehicle_id" options="{'no_create': True}" attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                            <field name="driver_id" options="{'no_create': True}" attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                            <field name="driver_user_id" options="{'no_create': True}" groups="uta_transport_monitor.group_transport_manager" attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                            <field name="source_type" widget="radio" options="{'horizontal': true}" attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                        </group>
                        <group string="Ruta">
                            <field name="route_id" options="{'no_create': True}" attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                            <field name="route_version_id" options="{'no_create': True}" attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                            <field name="scheduled_distance_m"/>
                            <field name="evaluation_status" widget="badge" decoration-success="evaluation_status == 'compliant'" decoration-danger="evaluation_status == 'non_compliant'" decoration-warning="evaluation_status == 'indeterminate'" decoration-info="evaluation_status == 'unevaluated'"/>
                        </group>
                    </group>
                    <group>
                        <group string="Horario (hora de Ecuador)">
                            <field name="scheduled_start_utc" string="Salida programada" attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                            <field name="scheduled_duration_display" string="Duración prevista" readonly="1"/>
                            <field name="scheduled_end_utc" string="Llegada prevista" attrs="{'readonly': ['|', ('state', '!=', 'draft'), ('is_manual_duration_override', '=', False)]}"/>
                            <field name="is_manual_duration_override" attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                            <field name="manual_duration_override_reason" attrs="{'invisible': [('is_manual_duration_override', '=', False)], 'required': [('is_manual_duration_override', '=', True)], 'readonly': [('state', '!=', 'draft')]}"/>
                            <field name="manual_duration_override_user_id" attrs="{'invisible': [('is_manual_duration_override', '=', False)]}" readonly="1"/>
                        </group>
                        <group string="Ejecución real" attrs="{'invisible': [('state', 'in', ('draft', 'scheduled'))]}">
                            <field name="actual_start_utc" string="Salida real"/>
                            <field name="actual_end_utc" string="Llegada real"/>
                            <field name="actual_duration_display" string="Duración real" readonly="1"/>
                            <field name="actual_distance_m"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Paradas" name="stops_page">
                            <field name="stop_visit_ids" readonly="1">
                                <tree string="Visitas a Puntos de Control">
                                    <field name="sequence"/>
                                    <field name="stop_name"/>
                                    <field name="stop_type" widget="badge" decoration-info="stop_type == 'checkpoint'" decoration-primary="stop_type == 'origin'" decoration-success="stop_type == 'destination'"/>
                                    <field name="required" widget="boolean_toggle"/>
                                    <field name="scheduled_at_utc" string="Hora Prevista"/>
                                    <field name="first_arrival_utc" string="Llegada registrada"/>
                                    <field name="delay_s"/>
                                    <field name="status" widget="badge" decoration-info="status == 'pending'" decoration-success="status == 'on_time'" decoration-warning="status == 'late'" decoration-danger="status == 'missed'"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Evaluación" name="evaluation_page" attrs="{'invisible': [('evaluation_count', '=', 0)]}">
                            <field name="evaluation_ids" readonly="1">
                                <tree string="Historial de Evaluaciones">
                                    <field name="name"/>
                                    <field name="evaluation_date"/>
                                    <field name="integrity_status" widget="badge"/>
                                    <field name="is_compliant_gross" widget="boolean_toggle"/>
                                    <field name="is_compliant_adjusted" widget="boolean_toggle"/>
                                    <field name="stops_on_time"/>
                                    <field name="stops_total"/>
                                    <field name="deviation_count"/>
                                    <field name="gps_gap_count"/>
                                    <field name="evaluation_summary"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Incidencias" name="incidents_page">
                            <field name="incident_ids">
                                <tree string="Incidencias Registradas" decoration-danger="severity in ('critical', 'high')" decoration-warning="severity == 'medium'" decoration-success="state == 'justified'">
                                    <field name="name"/>
                                    <field name="timestamp_utc"/>
                                    <field name="incident_type"/>
                                    <field name="source"/>
                                    <field name="severity" widget="badge"/>
                                    <field name="state" widget="badge"/>
                                    <field name="description"/>
                                    <button name="action_open_justify_wizard"
                                            string="Justificar"
                                            type="object"
                                            icon="fa-commenting-o"
                                            class="btn-sm btn-outline-info"
                                            attrs="{'invisible': [('state', 'in', ('justified', 'rejected'))]}"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Detalles técnicos" name="technical_page" groups="uta_transport_monitor.group_transport_manager,uta_transport_monitor.group_transport_analyst">
                            <group>
                                <group string="Evidencia de inicio y fin">
                                    <field name="actual_start_evidence"/>
                                    <field name="actual_end_evidence"/>
                                    <field name="first_gps_fix_utc" string="Primera posición GPS"/>
                                    <field name="manual_start_utc" string="Inicio manual" groups="uta_transport_monitor.group_transport_manager"/>
                                    <field name="manual_end_utc" string="Fin manual" groups="uta_transport_monitor.group_transport_manager"/>
                                    <field name="road_estimated_duration_display" string="Estimación por red vial" readonly="1"/>
                                </group>
                                <group string="Tolerancias aplicadas">
                                    <field name="stop_radius_m"/>
                                    <field name="route_corridor_m"/>
                                    <field name="lateness_tolerance_s"/>
                                    <field name="gps_gap_threshold_s"/>
                                </group>
                            </group>
                            <separator string="Posiciones GPS del recorrido"/>
                            <field name="position_ids" readonly="1">
                                <tree string="Posiciones GPS" limit="20">
                                    <field name="fix_time_utc"/>
                                    <field name="fix_time_local"/>
                                    <field name="fix_time" string="Fecha/Hora Odoo" optional="hide"/>
                                    <field name="latitude"/>
                                    <field name="longitude"/>
                                    <field name="speed"/>
                                    <field name="source" widget="badge" decoration-success="source == 'real'" decoration-warning="source == 'simulated'" decoration-info="source == 'unverified'"/>
                                    <field name="association_status" widget="badge" decoration-success="association_status == 'associated'" decoration-danger="association_status == 'ambiguous'"/>
                                </tree>
                            </field>
                            <separator string="Parámetros registrados (solo lectura)"/>
                            <field name="parameter_snapshot_json" widget="ace" options="{'mode': 'json'}" readonly="1"/>
                        </page>
                        <page string="Observaciones" name="notes_page">
                            <field name="notes" placeholder="Novedades del conductor o del despachador..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Search View: Recorridos -->
    <record id="view_transport_trip_search" model="ir.ui.view">
        <field name="name">transport.trip.search</field>
        <field name="model">transport.trip</field>
        <field name="arch" type="xml">
            <search string="Buscar Recorridos">
                <field name="name"/>
                <field name="vehicle_id"/>
                <field name="driver_id"/>
                <field name="route_id"/>
                <separator/>
                <filter string="Mis Recorridos" name="filter_my_trips" domain="['|', ('driver_user_id', '=', uid), ('driver_id.user_ids', 'in', [uid])]"/>
                <separator/>
                <filter string="Borradores" name="filter_draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Programados" name="filter_scheduled" domain="[('state', '=', 'scheduled')]"/>
                <filter string="En Curso" name="filter_in_progress" domain="[('state', '=', 'in_progress')]"/>
                <filter string="Finalizados" name="filter_completed" domain="[('state', '=', 'completed')]"/>
                <filter string="Cancelados" name="filter_cancelled" domain="[('state', '=', 'cancelled')]"/>
                <separator/>
                <filter string="Datos Reales" name="filter_real" domain="[('source_type', '=', 'real')]"/>
                <filter string="Simulados" name="filter_simulated" domain="[('source_type', '=', 'simulated')]"/>
                <group expand="0" string="Agrupar Por">
                    <filter string="Estado" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Ruta" name="group_route" context="{'group_by': 'route_id'}"/>
                    <filter string="Vehículo" name="group_vehicle" context="{'group_by': 'vehicle_id'}"/>
                    <filter string="Conductor" name="group_driver" context="{'group_by': 'driver_id'}"/>
                    <filter string="Tipo de Datos" name="group_source" context="{'group_by': 'source_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action Window: Todos los Recorridos (Administrador / Analista) -->
    <record id="action_transport_trip" model="ir.actions.act_window">
        <field name="name">Recorridos Operacionales</field>
        <field name="res_model">transport.trip</field>
        <field name="view_mode">tree,kanban,form</field>
        <field name="search_view_id" ref="view_transport_trip_search"/>
        <field name="help" type="html">
            <div class="grx-nocontent">
                <div class="grx-nocontent-icon grx-nc-route"/>
                <h3>No hay recorridos programados</h3>
                <p>Crea un recorrido asignando vehículo, conductor, ruta aprobada y horario previsto para iniciar el monitoreo.</p>
            </div>
        </field>
    </record>

    <!-- Action Window: Mis Recorridos (Conductor — Agenda/Listado por defecto) -->
    <record id="action_transport_trip_my_driver" model="ir.actions.act_window">
        <field name="name">Mis recorridos</field>
        <field name="res_model">transport.trip</field>
        <field name="view_mode">tree,kanban,form</field>
        <field name="view_id" ref="view_transport_trip_driver_tree"/>
        <field name="domain">['|', ('driver_user_id', '=', uid), ('driver_id.user_ids', 'in', [uid])]</field>
        <field name="context">{'search_default_filter_my_trips': 1}</field>
        <field name="search_view_id" ref="view_transport_trip_search"/>
        <field name="help" type="html">
            <div class="grx-nocontent">
                <div class="grx-nocontent-icon grx-nc-route"/>
                <h3>Aún no tienes recorridos asignados</h3>
                <p>Cuando el coordinador programe tu jornada, verás aquí tus horarios, rutas y seguimiento en tiempo real.</p>
            </div>
        </field>
    </record>
</odoo>
