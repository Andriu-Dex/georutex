<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vista Lista: Incidencias Operacionales -->
    <record id="view_transport_incident_tree" model="ir.ui.view">
        <field name="name">transport.incident.tree</field>
        <field name="model">transport.incident</field>
        <field name="arch" type="xml">
            <tree string="Incidencias">
                <field name="incident_type" string="Tipo de incidencia"/>
                <field name="trip_id" string="Recorrido"/>
                <field name="timestamp_utc" string="Fecha y hora"/>
                <field name="severity" string="Prioridad" widget="badge"/>
                <field name="state" string="Estado" widget="badge"
                       decoration-info="state == 'pending'"
                       decoration-success="state == 'justified'"
                       decoration-danger="state == 'rejected'"
                       decoration-warning="state == 'confirmed'"/>
                <field name="vehicle_id" string="Vehículo" groups="uta_transport_monitor.group_transport_analyst,uta_transport_monitor.group_transport_manager"/>
                <field name="driver_id" string="Conductor" groups="uta_transport_monitor.group_transport_analyst,uta_transport_monitor.group_transport_manager"/>
                <field name="source" string="Origen" groups="uta_transport_monitor.group_transport_analyst,uta_transport_monitor.group_transport_manager" optional="hide"/>
                <field name="name" string="Código" optional="hide"/>
                <button name="action_open_justify_wizard"
                        string="Justificar"
                        type="object"
                        icon="fa-commenting-o"
                        class="btn-sm btn-outline-info"
                        attrs="{'invisible': [('state', 'in', ('justified', 'rejected'))]}"/>
            </tree>
        </field>
    </record>

    <!-- Vista Formulario: Tarjeta Editable Lateral Derecha (Bootstrap 5 + SCSS) -->
    <record id="view_transport_incident_form" model="ir.ui.view">
        <field name="name">transport.incident.form</field>
        <field name="model">transport.incident</field>
        <field name="arch" type="xml">
            <form string="Incidencia" class="o_georutex_incident_form">
                <header attrs="{'invisible': [('id', '=', False)]}">
                    <button name="action_open_justify_wizard"
                            string="Justificar incidencia"
                            type="object"
                            class="oe_highlight btn-info"
                            icon="fa-commenting-o"
                            attrs="{'invisible': ['|', ('id', '=', False), ('state', 'in', ('justified', 'rejected'))]}"/>
                    <button name="action_submit_justification"
                            string="Enviar justificación"
                            type="object"
                            class="btn-primary"
                            attrs="{'invisible': ['|', ('id', '=', False), ('state', '!=', 'pending')]}"/>
                    <button name="action_approve_justification"
                            string="Aprobar justificación"
                            type="object"
                            class="btn-success"
                            groups="uta_transport_monitor.group_transport_analyst,uta_transport_monitor.group_transport_manager"
                            attrs="{'invisible': ['|', ('id', '=', False), ('state', '!=', 'pending')]}"/>
                    <button name="action_reject_justification"
                            string="Rechazar justificación"
                            type="object"
                            class="btn-danger"
                            groups="uta_transport_monitor.group_transport_analyst,uta_transport_monitor.group_transport_manager"
                            attrs="{'invisible': ['|', ('id', '=', False), ('state', '!=', 'pending')]}"/>
                    <button name="action_confirm_incident"
                            string="Confirmar sin justificación"
                            type="object"
                            class="btn-secondary"
                            groups="uta_transport_monitor.group_transport_analyst,uta_transport_monitor.group_transport_manager"
                            attrs="{'invisible': ['|', ('id', '=', False), ('state', '!=', 'pending')]}"/>
                    <field name="state"
                           widget="badge"
                           class="ms-auto"
                           decoration-info="state == 'pending'"
                           decoration-success="state == 'justified'"
                           decoration-danger="state == 'rejected'"
                           decoration-warning="state == 'confirmed'"/>
                </header>

                <sheet>
                    <field name="source" invisible="1"/>
                    <div class="o_georutex_incident_card_header">
                        <div class="grx-incident-head-compact">
                            <span class="grx-incident-code-badge"><field name="name" readonly="1"/></span>
                            <p class="o_georutex_incident_card_subtitle">
                                Registra la novedad del recorrido; el equipo de operación revisará tu reporte.
                            </p>
                        </div>
                    </div>

                    <group>
                        <group string="Recorrido">
                            <field name="trip_id" string="Recorrido asociado" options="{'no_create': True}" placeholder="Selecciona tu recorrido..."/>
                            <div class="text-muted small py-1" colspan="2"
                                 attrs="{'invisible': [('trip_id', '!=', False)]}">
                                Al seleccionar un recorrido, se completarán automáticamente el vehículo, la ruta y el conductor asociados.
                            </div>
                            <field name="vehicle_id" string="Vehículo" attrs="{'invisible': [('trip_id', '=', False)]}"/>
                            <field name="route_id" string="Ruta" attrs="{'invisible': [('trip_id', '=', False)]}"/>
                            <field name="driver_id" string="Conductor" attrs="{'invisible': [('trip_id', '=', False)]}"/>
                        </group>
                        <group string="¿Qué ocurrió?">
                            <field name="incident_type" string="Tipo de incidencia"/>
                            <field name="severity" string="Prioridad"/>
                            <field name="timestamp_utc" string="Fecha y hora"/>
                            <field name="source" string="Origen"
                                   groups="uta_transport_monitor.group_transport_analyst,uta_transport_monitor.group_transport_manager"
                                   attrs="{'readonly': [('source', '=', 'automatic')]}"/>
                        </group>
                    </group>

                    <group string="Ubicación">
                        <group>
                            <field name="stop_id" string="Parada afectada" options="{'no_create': True}" placeholder="Opcional: selecciona una parada..."/>
                            <field name="rule_applied" string="Regla evaluada"
                                   groups="uta_transport_monitor.group_transport_analyst,uta_transport_monitor.group_transport_manager"
                                   attrs="{'readonly': [('source', '=', 'automatic')]}"
                                   placeholder="Referencia automática o nota operativa"/>
                        </group>
                        <group>
                            <field name="latitude" string="Latitud"
                                   attrs="{'invisible': [('latitude', '=', 0), ('longitude', '=', 0)]}"/>
                            <field name="longitude" string="Longitud"
                                   attrs="{'invisible': [('latitude', '=', 0), ('longitude', '=', 0)]}"/>
                            <div class="text-muted small py-1" colspan="2"
                                 attrs="{'invisible': ['|', ('latitude', '!=', 0), ('longitude', '!=', 0)]}">
                                Sin coordenadas GPS registradas manualmente; se vinculan automáticamente desde el recorrido cuando hay telemetría disponible.
                            </div>
                        </group>
                    </group>

                    <notebook>
                        <page string="Evidencia y detalles" name="incident_description_page">
                            <group>
                                <field name="description" string="Descripción" placeholder="Describe brevemente lo ocurrido durante el recorrido..."/>
                                <field name="evidence_data" string="Observaciones de respaldo"
                                       attrs="{'readonly': [('source', '=', 'automatic')]}"
                                       placeholder="Referencias de sector, hora o respaldo operativo..."/>
                            </group>
                        </page>
                        <page string="Justificación" name="incident_justification_page">
                            <group string="Justificación del conductor">
                                <field name="justification_notes" string="Motivo" placeholder="Explica el motivo que justifica la novedad o retraso..."/>
                                <field name="justification_submitted_by" string="Reportado por"/>
                                <field name="justification_submitted_at" string="Fecha de envío"/>
                            </group>
                            <group string="Revisión operativa">
                                <field name="review_notes" string="Observaciones del revisor" placeholder="Observaciones de la aprobación o rechazo..."
                                       groups="uta_transport_monitor.group_transport_analyst,uta_transport_monitor.group_transport_manager"/>
                                <field name="reviewed_by" string="Revisado por"/>
                                <field name="reviewed_at" string="Fecha de revisión"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Vista Búsqueda / Filtros -->
    <record id="view_transport_incident_search" model="ir.ui.view">
        <field name="name">transport.incident.search</field>
        <field name="model">transport.incident</field>
        <field name="arch" type="xml">
            <search string="Buscar Incidencias">
                <field name="name" string="Código"/>
                <field name="trip_id" string="Recorrido"/>
                <field name="vehicle_id" string="Vehículo"/>
                <field name="driver_id" string="Conductor"/>
                <filter string="Pendientes" name="pending" domain="[('state', '=', 'pending')]"/>
                <filter string="Justificadas" name="justified" domain="[('state', '=', 'justified')]"/>
                <filter string="Rechazadas" name="rejected" domain="[('state', '=', 'rejected')]"/>
                <separator/>
                <filter string="Automáticas" name="automatic" domain="[('source', '=', 'automatic')]"/>
                <filter string="Manuales" name="manual" domain="[('source', '=', 'manual')]"/>
                <separator/>
                <filter string="Alta Severidad / Crítica" name="high_severity" domain="[('severity', 'in', ('high', 'critical'))]"/>
                <group expand="0" string="Agrupar por">
                    <filter string="Recorrido" name="group_trip" context="{'group_by': 'trip_id'}"/>
                    <filter string="Tipo de Incidencia" name="group_type" context="{'group_by': 'incident_type'}"/>
                    <filter string="Estado" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Severidad" name="group_severity" context="{'group_by': 'severity'}"/>
                    <filter string="Origen" name="group_source" context="{'group_by': 'source'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Acción Principal: Incidencias -->
    <record id="action_transport_incident" model="ir.actions.act_window">
        <field name="name">Incidencias</field>
        <field name="res_model">transport.incident</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_transport_incident_search"/>
        <field name="help" type="html">
            <div class="grx-nocontent">
                <div class="grx-nocontent-icon grx-nc-incident"/>
                <h3>Sin incidencias registradas</h3>
                <p>Las novedades reportadas por conductores o detectadas durante la operación aparecerán aquí para su seguimiento.</p>
            </div>
        </field>
    </record>

    <!-- Wizard: Justificación Rápida -->
    <record id="view_transport_incident_justify_wizard_form" model="ir.ui.view">
        <field name="name">transport.incident.justify.wizard.form</field>
        <field name="model">transport.incident.justify.wizard</field>
        <field name="arch" type="xml">
            <form string="Justificación de Incidencia Operacional">
                <sheet>
                    <div class="alert alert-info" role="alert">
                        <strong>Descargo Operacional:</strong> Seleccione el motivo e ingrese los detalles que justifican el retraso, desvío u omisión ocurrida durante el recorrido.
                    </div>
                    <group>
                        <group string="Datos del Evento">
                            <field name="incident_id" string="Incidencia"/>
                            <field name="trip_id" string="Recorrido"/>
                            <field name="incident_type" string="Tipo"/>
                        </group>
                        <group string="Motivo de Descargo">
                            <field name="justification_category" string="Categoría" widget="radio"/>
                        </group>
                    </group>
                    <group string="Explicación Detallada">
                        <field name="justification_notes" placeholder="Describa brevemente qué ocurrió (ej. Cierre vial por manifestación o desvío ordenado por agentes de tránsito)..." nolabel="1"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_confirm_justification" string="Registrar y Enviar Descargo" type="object" class="btn-primary" icon="fa-paper-plane"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
