<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vista Lista: Incidencias Operacionales -->
    <record id="view_transport_incident_tree" model="ir.ui.view">
        <field name="name">transport.incident.tree</field>
        <field name="model">transport.incident</field>
        <field name="arch" type="xml">
            <tree string="Incidencias Operacionales"
                  decoration-danger="severity in ('critical', 'high')"
                  decoration-warning="severity == 'medium'"
                  decoration-success="state == 'justified'"
                  decoration-muted="state == 'rejected'">
                <field name="name" string="Código"/>
                <field name="timestamp_utc" string="Fecha y Hora"/>
                <field name="trip_id" string="Recorrido"/>
                <field name="vehicle_id" string="Vehículo"/>
                <field name="driver_id" string="Conductor"/>
                <field name="incident_type" string="Tipo de Incidencia"/>
                <field name="source" string="Origen"/>
                <field name="severity" string="Severidad" widget="badge"/>
                <field name="state" string="Estado" widget="badge"
                       decoration-info="state == 'pending'"
                       decoration-success="state == 'justified'"
                       decoration-danger="state == 'rejected'"
                       decoration-warning="state == 'confirmed'"/>
                <button name="action_open_justify_wizard"
                        string="Justificar"
                        type="object"
                        icon="fa-commenting-o"
                        class="btn-sm btn-outline-info"
                        attrs="{'invisible': [('state', 'in', ('justified', 'rejected'))]}"/>
            </tree>
        </field>
    </record>

    <!-- Vista Formulario: Tarjeta Editable Lateral Derecha (Bootstrap 5 + SCSS) -->
    <record id="view_transport_incident_form" model="ir.ui.view">
        <field name="name">transport.incident.form</field>
        <field name="model">transport.incident</field>
        <field name="arch" type="xml">
            <form string="Incidencia Operacional" class="o_georutex_incident_form">
                <header>
                    <button name="action_open_justify_wizard"
                            string="Justificar Incidencia"
                            type="object"
                            class="oe_highlight btn-info"
                            icon="fa-commenting-o"
                            attrs="{'invisible': ['|', ('id', '=', False), ('state', 'in', ('justified', 'rejected'))]}"/>
                    <button name="action_submit_justification"
                            string="Enviar Justificación"
                            type="object"
                            class="btn-primary"
                            attrs="{'invisible': ['|', ('id', '=', False), ('state', '!=', 'pending')]}"/>
                    <button name="action_approve_justification"
                            string="Aprobar Justificación"
                            type="object"
                            class="btn-success"
                            groups="uta_transport_monitor.group_transport_analyst,uta_transport_monitor.group_transport_manager"
                            attrs="{'invisible': ['|', ('id', '=', False), ('state', '!=', 'pending')]}"/>
                    <button name="action_reject_justification"
                            string="Rechazar Justificación"
                            type="object"
                            class="btn-danger"
                            groups="uta_transport_monitor.group_transport_analyst,uta_transport_monitor.group_transport_manager"
                            attrs="{'invisible': ['|', ('id', '=', False), ('state', '!=', 'pending')]}"/>
                    <button name="action_confirm_incident"
                            string="Confirmar Sin Justificación"
                            type="object"
                            class="btn-secondary"
                            groups="uta_transport_monitor.group_transport_analyst,uta_transport_monitor.group_transport_manager"
                            attrs="{'invisible': ['|', ('id', '=', False), ('state', '!=', 'pending')]}"/>
                    <field name="state" widget="statusbar" statusbar_visible="pending,justified,rejected,confirmed"/>
                </header>

                <!-- Panel contextual izquierdo (escritorio) que enmarca la tarjeta derecha editable -->
                <div class="o_georutex_incident_context_col">
                    <span class="o_georutex_ctx_badge">
                        <i class="fa fa-exclamation-triangle" aria-hidden="true"/> Reporte Operacional UTA
                    </span>
                    <h3>Gestión de Incidencias del Recorrido</h3>
                    <p>
                        Registra o actualiza cualquier novedad presentada en tu ruta. Todos los campos del reporte manual son editables en la tarjeta de la derecha.
                    </p>
                    <ul class="o_georutex_ctx_list">
                        <li>
                            <i class="fa fa-bus" aria-hidden="true"/>
                            <span>Selecciona el <strong>recorrido asignado</strong> para asociar automáticamente tu vehículo, ruta y conductor.</span>
                        </li>
                        <li>
                            <i class="fa fa-map-marker" aria-hidden="true"/>
                            <span>Indica el <strong>tipo de novedad</strong>, severidad, parada afectada y coordenadas si las conoces.</span>
                        </li>
                        <li>
                            <i class="fa fa-file-text-o" aria-hidden="true"/>
                            <span>Detalla la <strong>descripción y descargo</strong> para que el analista o administrador revise tu justificación.</span>
                        </li>
                    </ul>
                </div>

                <sheet>
                    <div class="o_georutex_incident_card_header">
                        <div class="oe_title mb-0">
                            <label for="name" string="Código de Incidencia"/>
                            <h1 class="mb-1">
                                <field name="name"/>
                            </h1>
                            <p class="o_georutex_incident_card_subtitle">
                                Formulario editable de incidencia operacional de transporte
                            </p>
                        </div>
                        <span class="badge rounded-pill text-bg-primary px-3 py-2">
                            <i class="fa fa-pencil me-1" aria-hidden="true"/> Edición Habilitada
                        </span>
                    </div>

                    <group>
                        <group string="Detalles del Recorrido">
                            <field name="trip_id" string="Recorrido Asociado" options="{'no_create': True}" placeholder="Seleccione su recorrido..."/>
                            <field name="vehicle_id" string="Vehículo"/>
                            <field name="route_id" string="Ruta"/>
                            <field name="driver_id" string="Conductor"/>
                        </group>
                        <group string="Clasificación de la Incidencia">
                            <field name="incident_type" string="Tipo de Incidencia"/>
                            <field name="source" string="Origen" attrs="{'readonly': [('source', '=', 'automatic')]}"/>
                            <field name="severity" string="Severidad"/>
                            <field name="timestamp_utc" string="Fecha y Hora del Evento"/>
                        </group>
                    </group>

                    <group string="Ubicación y Referencia Normativa">
                        <group>
                            <field name="stop_id" string="Parada Afectada" options="{'no_create': True}" placeholder="Opcional: seleccione la parada..."/>
                            <field name="rule_applied" string="Referencia / Regla Aplicada" attrs="{'readonly': [('source', '=', 'automatic')]}" placeholder="Ej. Novedad en vía / RF-28"/>
                        </group>
                        <group>
                            <field name="latitude" string="Latitud del Evento"/>
                            <field name="longitude" string="Longitud del Evento"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Descripción y Evidencia" name="incident_description_page">
                            <group>
                                <field name="description" string="Descripción del Incidente" placeholder="Describa detalladamente lo ocurrido durante el recorrido..."/>
                                <field name="evidence_data" string="Evidencia / Observaciones Adicionales" attrs="{'readonly': [('source', '=', 'automatic')]}" placeholder="Ingrese observaciones, referencias de horario, sector o detalles de respaldo..."/>
                            </group>
                        </page>
                        <page string="Descargo / Justificación" name="incident_justification_page">
                            <group string="Descargo del Conductor / Operador">
                                <field name="justification_notes" string="Motivo de Justificación" placeholder="Ingrese el motivo que justifica la novedad o retraso..."/>
                                <field name="justification_submitted_by" string="Enviado Por"/>
                                <field name="justification_submitted_at" string="Fecha de Envío"/>
                            </group>
                            <group string="Resolución de Revisión">
                                <field name="review_notes" string="Observaciones del Revisor" placeholder="Observaciones de la aprobación o rechazo..."
                                       groups="uta_transport_monitor.group_transport_analyst,uta_transport_monitor.group_transport_manager"/>
                                <field name="reviewed_by" string="Revisado Por"/>
                                <field name="reviewed_at" string="Fecha de Revisión"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Vista Búsqueda / Filtros -->
    <record id="view_transport_incident_search" model="ir.ui.view">
        <field name="name">transport.incident.search</field>
        <field name="model">transport.incident</field>
        <field name="arch" type="xml">
            <search string="Buscar Incidencias">
                <field name="name" string="Código"/>
                <field name="trip_id" string="Recorrido"/>
                <field name="vehicle_id" string="Vehículo"/>
                <field name="driver_id" string="Conductor"/>
                <filter string="Pendientes" name="pending" domain="[('state', '=', 'pending')]"/>
                <filter string="Justificadas" name="justified" domain="[('state', '=', 'justified')]"/>
                <filter string="Rechazadas" name="rejected" domain="[('state', '=', 'rejected')]"/>
                <separator/>
                <filter string="Automáticas" name="automatic" domain="[('source', '=', 'automatic')]"/>
                <filter string="Manuales" name="manual" domain="[('source', '=', 'manual')]"/>
                <separator/>
                <filter string="Alta Severidad / Crítica" name="high_severity" domain="[('severity', 'in', ('high', 'critical'))]"/>
                <group expand="0" string="Agrupar por">
                    <filter string="Recorrido" name="group_trip" context="{'group_by': 'trip_id'}"/>
                    <filter string="Tipo de Incidencia" name="group_type" context="{'group_by': 'incident_type'}"/>
                    <filter string="Estado" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Severidad" name="group_severity" context="{'group_by': 'severity'}"/>
                    <filter string="Origen" name="group_source" context="{'group_by': 'source'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Acción Principal: Incidencias Operacionales -->
    <record id="action_transport_incident" model="ir.actions.act_window">
        <field name="name">Incidencias Operacionales</field>
        <field name="res_model">transport.incident</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_transport_incident_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No tienes incidencias operacionales registradas
            </p>
            <p>
                Haz clic en <strong>Nuevo</strong> para abrir la tarjeta lateral derecha y reportar una incidencia de tu recorrido.
            </p>
        </field>
    </record>

    <!-- Wizard: Justificación Rápida -->
    <record id="view_transport_incident_justify_wizard_form" model="ir.ui.view">
        <field name="name">transport.incident.justify.wizard.form</field>
        <field name="model">transport.incident.justify.wizard</field>
        <field name="arch" type="xml">
            <form string="Justificación de Incidencia Operacional">
                <sheet>
                    <div class="alert alert-info" role="alert">
                        <strong>Descargo Operacional:</strong> Seleccione el motivo e ingrese los detalles que justifican el retraso, desvío u omisión ocurrida durante el recorrido.
                    </div>
                    <group>
                        <group string="Datos del Evento">
                            <field name="incident_id" string="Incidencia"/>
                            <field name="trip_id" string="Recorrido"/>
                            <field name="incident_type" string="Tipo"/>
                        </group>
                        <group string="Motivo de Descargo">
                            <field name="justification_category" string="Categoría" widget="radio"/>
                        </group>
                    </group>
                    <group string="Explicación Detallada">
                        <field name="justification_notes" placeholder="Describa brevemente qué ocurrió (ej. Cierre vial por manifestación o desvío ordenado por agentes de tránsito)..." nolabel="1"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_confirm_justification" string="Registrar y Enviar Descargo" type="object" class="btn-primary" icon="fa-paper-plane"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
