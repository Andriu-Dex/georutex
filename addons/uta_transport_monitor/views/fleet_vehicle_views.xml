<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_fleet_vehicle_form_inherit_georutex" model="ir.ui.view">
        <field name="name">fleet.vehicle.form.georutex</field>
        <field name="model">fleet.vehicle</field>
        <field name="inherit_id" ref="fleet.fleet_vehicle_view_form"/>
        <field name="arch" type="xml">
            <!-- Header buttons -->
            <xpath expr="//header" position="inside">
                <button name="action_test_traccar_connection"
                        type="object"
                        string="Probar Conexión Traccar"
                        class="btn-secondary"
                        groups="uta_transport_monitor.group_transport_manager"/>
                <button name="action_sync_gps_positions"
                        type="object"
                        string="Sincronizar GPS"
                        class="btn-primary"
                        groups="uta_transport_monitor.group_transport_manager"/>
                <button name="action_generate_secure_unique_id"
                        type="object"
                        string="Generar uniqueId Seguro"
                        class="btn-secondary"
                        groups="uta_transport_monitor.group_transport_manager"
                        help="Genera un identificador con 128 bits de entropía para Traccar Client."/>
            </xpath>

            <!-- Smart button in button box -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_positions"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-location-arrow">
                    <field name="position_count" widget="statinfo" string="Posiciones GPS"/>
                </button>
                <button name="action_view_trips"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-road">
                    <field name="trip_count" widget="statinfo" string="Recorridos"/>
                </button>
            </xpath>

            <!-- Operational Name in title header -->
            <xpath expr="//div[hasclass('oe_title')]/label[@for='model_id']" position="before">
                <label for="operational_name" class="oe_edit_only"/>
                <h1>
                    <field name="operational_name" placeholder="e.g. Bus 01 - UTA / Unidad 14"/>
                </h1>
            </xpath>

            <!-- Dedicated Notebook Page for Traccar Telemetry and Trips -->
            <xpath expr="//notebook" position="inside">
                <page string="Telemetría GPS / Traccar" name="georutex_gps">
                    <group>
                        <group string="Vinculación de Dispositivo">
                            <field name="traccar_device_id"/>
                            <field name="traccar_unique_id"/>
                            <field name="gps_tracking_enabled"/>
                            <field name="is_physical_accredited" widget="boolean_toggle"/>
                            <field name="is_simulated" widget="boolean_toggle"/>
                            <field name="gps_connection_status"
                                   widget="badge"
                                   decoration-success="gps_connection_status == 'online'"
                                   decoration-info="gps_connection_status == 'recent'"
                                   decoration-warning="gps_connection_status == 'offline'"
                                   decoration-muted="gps_connection_status == 'unlinked'"/>
                        </group>
                        <group string="Última Telemetría Recibida">
                            <field name="last_gps_fix_time"/>
                            <field name="last_gps_time_local"/>
                            <field name="gps_freshness_state"
                                   widget="badge"
                                   decoration-success="gps_freshness_state == 'fresh'"
                                   decoration-warning="gps_freshness_state == 'stale'"
                                   decoration-danger="gps_freshness_state == 'offline'"/>
                            <field name="last_gps_age_seconds"/>
                            <field name="last_gps_latitude"/>
                            <field name="last_gps_longitude"/>
                            <field name="last_gps_speed"/>
                        </group>
                    </group>
                </page>
                <page string="Ubicación en Vivo" name="vehicle_live_map">
                    <field name="id" widget="vehicle_map_widget" nolabel="1"/>
                </page>
                <page string="Recorridos Asignados" name="georutex_trips">
                    <field name="trip_ids" readonly="1">
                        <tree string="Recorridos">
                            <field name="name"/>
                            <field name="route_id"/>
                            <field name="scheduled_start_utc"/>
                            <field name="scheduled_end_utc"/>
                            <field name="source_type" widget="badge"/>
                            <field name="state" widget="badge" decoration-info="state == 'draft'" decoration-primary="state == 'scheduled'" decoration-warning="state == 'in_progress'" decoration-success="state == 'completed'"/>
                        </tree>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

    <!-- Kanban View Inheritance for Operational Name & GPS Status Badge -->
    <record id="view_fleet_vehicle_kanban_inherit_georutex" model="ir.ui.view">
        <field name="name">fleet.vehicle.kanban.georutex</field>
        <field name="model">fleet.vehicle</field>
        <field name="inherit_id" ref="fleet.fleet_vehicle_view_kanban"/>
        <field name="arch" type="xml">
            <xpath expr="//kanban" position="inside">
                <field name="operational_name"/>
                <field name="gps_connection_status"/>
            </xpath>
            <xpath expr="//strong[hasclass('o_kanban_record_title')]" position="replace">
                <strong class="o_kanban_record_title">
                    <t t-if="record.operational_name.raw_value">
                        <span class="badge text-bg-primary fs-6 mb-1 d-block text-start">
                            <i class="fa fa-bus me-1" title="Unidad"/> <field name="operational_name"/>
                        </span>
                    </t>
                    <t t-if="record.license_plate.raw_value"><field name="license_plate"/>: </t>
                    <field name="model_id"/>
                </strong>
            </xpath>
        </field>
    </record>

    <!-- Tree View Inheritance for Operational Name Column -->
    <record id="view_fleet_vehicle_tree_inherit_georutex" model="ir.ui.view">
        <field name="name">fleet.vehicle.tree.georutex</field>
        <field name="model">fleet.vehicle</field>
        <field name="inherit_id" ref="fleet.fleet_vehicle_view_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='license_plate']" position="before">
                <field name="operational_name" optional="show"/>
            </xpath>
        </field>
    </record>

    <!-- Search View Inheritance for GPS Filters -->
    <record id="view_fleet_vehicle_search_inherit_georutex" model="ir.ui.view">
        <field name="name">fleet.vehicle.search.georutex</field>
        <field name="model">fleet.vehicle</field>
        <field name="inherit_id" ref="fleet.fleet_vehicle_view_search"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='alert_true']" position="before">
                <field name="operational_name" string="Nombre Operativo / Unidad"/>
                <filter string="Monitoreo GPS Activo"
                        name="filter_gps_monitored"
                        domain="[('gps_tracking_enabled', '=', True)]"/>
                <filter string="Dispositivos Vinculados"
                        name="filter_gps_linked"
                        domain="['|', ('traccar_device_id', '!=', False), ('traccar_unique_id', '!=', False)]"/>
                <filter string="Solo Físicos Acreditados"
                        name="filter_physical_accredited"
                        domain="[('is_physical_accredited', '=', True)]"/>
                <separator/>
            </xpath>
        </field>
    </record>

    <!-- Dedicated GeoRutex Monitored Fleet Action -->
    <record id="action_transport_monitored_fleet" model="ir.actions.act_window">
        <field name="name">Vehículos Monitoreados</field>
        <field name="res_model">fleet.vehicle</field>
        <field name="view_mode">kanban,tree,form,activity</field>
        <field name="context">{'search_default_filter_gps_monitored': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No hay vehículos monitoreados registrados en GeoRutex.
            </p>
            <p>
                Configure el rastreo GPS y vincule identificadores Traccar para comenzar el monitoreo.
            </p>
        </field>
    </record>
</odoo>
