<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_fleet_vehicle_form_inherit_georutex" model="ir.ui.view">
        <field name="name">fleet.vehicle.form.georutex</field>
        <field name="model">fleet.vehicle</field>
        <field name="inherit_id" ref="fleet.fleet_vehicle_view_form"/>
        <field name="arch" type="xml">
            <!-- Header buttons -->
            <xpath expr="//header" position="inside">
                <button name="action_test_traccar_connection"
                        type="object"
                        string="Probar conexión GPS"
                        class="btn-secondary"
                        groups="uta_transport_monitor.group_transport_manager"/>
                <button name="action_sync_gps_positions"
                        type="object"
                        string="Sincronizar GPS"
                        class="btn-primary"
                        groups="uta_transport_monitor.group_transport_manager"/>
                <button name="action_generate_secure_unique_id"
                        type="object"
                        string="Generar identificador seguro"
                        class="btn-secondary"
                        groups="uta_transport_monitor.group_transport_manager"
                        attrs="{'invisible': [('traccar_unique_id', '!=', False)]}"
                        help="Genera un identificador difícil de adivinar para configurar en la app Traccar Client del teléfono."/>
            </xpath>

            <!-- Restrict native Fleet maintenance/contract stat buttons to Fleet users (prevents AccessError on fleet.vehicle.log.services for Analysts/Drivers) -->
            <xpath expr="//button[field[@name='service_count']]" position="attributes">
                <attribute name="groups">fleet.fleet_group_user</attribute>
            </xpath>
            <xpath expr="//button[field[@name='contract_count']]" position="attributes">
                <attribute name="groups">fleet.fleet_group_user</attribute>
            </xpath>
            <xpath expr="//button[field[@name='history_count']]" position="attributes">
                <attribute name="groups">fleet.fleet_group_user</attribute>
            </xpath>
            <xpath expr="//button[field[@name='odometer_count']]" position="attributes">
                <attribute name="groups">fleet.fleet_group_user</attribute>
            </xpath>

            <!-- Smart button in button box -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_positions"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-location-arrow">
                    <field name="position_count" widget="statinfo" string="Posiciones GPS"/>
                </button>
                <button name="action_view_trips"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-road">
                    <field name="trip_count" widget="statinfo" string="Recorridos"/>
                </button>
            </xpath>

            <!-- Operational Name in title header -->
            <xpath expr="//div[hasclass('oe_title')]/label[@for='model_id']" position="before">
                <label for="operational_name" class="oe_edit_only"/>
                <h1>
                    <field name="operational_name" placeholder="Ej. Unidad 01 - Ruta Norte"/>
                </h1>
            </xpath>

            <!-- Dedicated Notebook Page for Traccar Telemetry and Trips -->
            <xpath expr="//notebook" position="inside">
                <page string="GPS" name="georutex_gps">
                    <group>
                        <group string="Dispositivo GPS">
                            <field name="traccar_device_id"/>
                            <field name="traccar_unique_id"/>
                            <field name="gps_tracking_enabled"/>
                            <field name="is_physical_accredited" widget="boolean_toggle"/>
                            <field name="is_simulated" widget="boolean_toggle"/>
                            <field name="gps_connection_status"
                                   widget="badge"
                                   decoration-success="gps_connection_status == 'online'"
                                   decoration-info="gps_connection_status == 'recent'"
                                   decoration-warning="gps_connection_status == 'offline'"
                                   decoration-muted="gps_connection_status == 'unlinked'"/>
                        </group>
                        <group string="Última posición recibida">
                            <field name="last_gps_fix_time"/>
                            <field name="last_gps_time_local"/>
                            <field name="gps_freshness_state"
                                   widget="badge"
                                   decoration-success="gps_freshness_state == 'fresh'"
                                   decoration-warning="gps_freshness_state == 'stale'"
                                   decoration-danger="gps_freshness_state == 'offline'"/>
                            <field name="last_gps_age_seconds"/>
                            <field name="last_gps_latitude"/>
                            <field name="last_gps_longitude"/>
                            <field name="last_gps_speed"/>
                        </group>
                    </group>
                </page>
                <page string="Ubicación en vivo" name="vehicle_live_map">
                    <field name="id" widget="vehicle_map_widget" nolabel="1"/>
                </page>
                <page string="Recorridos asignados" name="georutex_trips">
                    <field name="trip_ids" readonly="1">
                        <tree string="Recorridos">
                            <field name="name"/>
                            <field name="route_id"/>
                            <field name="scheduled_start_utc"/>
                            <field name="scheduled_end_utc"/>
                            <field name="source_type" widget="badge"/>
                            <field name="state" widget="badge" decoration-info="state == 'draft'" decoration-primary="state == 'scheduled'" decoration-warning="state == 'in_progress'" decoration-success="state == 'completed'"/>
                        </tree>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

    <!-- Kanban View Inheritance for Operational Name & GPS Status Badge -->
    <record id="view_fleet_vehicle_kanban_inherit_georutex" model="ir.ui.view">
        <field name="name">fleet.vehicle.kanban.georutex</field>
        <field name="model">fleet.vehicle</field>
        <field name="inherit_id" ref="fleet.fleet_vehicle_view_kanban"/>
        <field name="arch" type="xml">
            <xpath expr="//kanban" position="inside">
                <field name="operational_name"/>
                <field name="gps_connection_status"/>
            </xpath>
            <xpath expr="//strong[hasclass('o_kanban_record_title')]" position="replace">
                <strong class="o_kanban_record_title">
                    <t t-if="record.operational_name.raw_value">
                        <span class="badge text-bg-primary fs-6 mb-1 d-block text-start">
                            <i class="fa fa-bus me-1" title="Unidad"/> <field name="operational_name"/>
                        </span>
                    </t>
                    <t t-if="record.license_plate.raw_value"><field name="license_plate"/>: </t>
                    <field name="model_id"/>
                </strong>
            </xpath>
        </field>
    </record>

    <!-- Tree View Inheritance for Operational Name Column -->
    <record id="view_fleet_vehicle_tree_inherit_georutex" model="ir.ui.view">
        <field name="name">fleet.vehicle.tree.georutex</field>
        <field name="model">fleet.vehicle</field>
        <field name="inherit_id" ref="fleet.fleet_vehicle_view_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='license_plate']" position="before">
                <field name="operational_name" optional="show"/>
            </xpath>
        </field>
    </record>

    <!-- Search View Inheritance for GPS Filters -->
    <record id="view_fleet_vehicle_search_inherit_georutex" model="ir.ui.view">
        <field name="name">fleet.vehicle.search.georutex</field>
        <field name="model">fleet.vehicle</field>
        <field name="inherit_id" ref="fleet.fleet_vehicle_view_search"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='alert_true']" position="before">
                <field name="operational_name" string="Unidad"/>
                <filter string="Con rastreo GPS"
                        name="filter_gps_monitored"
                        domain="[('gps_tracking_enabled', '=', True)]"/>
                <filter string="Con dispositivo vinculado"
                        name="filter_gps_linked"
                        domain="['|', ('traccar_device_id', '!=', False), ('traccar_unique_id', '!=', False)]"/>
                <filter string="Solo dispositivos físicos"
                        name="filter_physical_accredited"
                        domain="[('is_physical_accredited', '=', True)]"/>
                <separator/>
            </xpath>
        </field>
    </record>

    <!-- Dedicated GeoRutex Monitored Fleet Tree View (avoids Fleet contracts/services AccessError for Analyst) -->
    <record id="view_georutex_monitored_fleet_tree" model="ir.ui.view">
        <field name="name">fleet.vehicle.tree.georutex.monitored</field>
        <field name="model">fleet.vehicle</field>
        <field name="priority" eval="40"/>
        <field name="arch" type="xml">
            <tree string="Vehículos">
                <field name="operational_name" string="Unidad"/>
                <field name="license_plate" string="Placa"/>
                <field name="model_id" string="Modelo"/>
                <field name="driver_id" string="Conductor"/>
                <field name="gps_connection_status" string="Conexión GPS" widget="badge"
                       decoration-success="gps_connection_status == 'online'"
                       decoration-info="gps_connection_status in ('recent', 'waiting')"
                       decoration-warning="gps_connection_status == 'offline'"
                       decoration-muted="gps_connection_status == 'unlinked'"/>
                <field name="last_gps_time_local" string="Último reporte"/>
                <field name="last_gps_speed" string="Velocidad (km/h)" optional="hide"/>
                <field name="is_simulated" string="Simulado" optional="hide"/>
                <field name="trip_count" string="Recorridos"/>
            </tree>
        </field>
    </record>

    <!-- Dedicated GeoRutex Monitored Fleet Form View (clean mobility & telemetry without Fleet log.services/log.contract) -->
    <record id="view_georutex_monitored_fleet_form" model="ir.ui.view">
        <field name="name">fleet.vehicle.form.georutex.monitored</field>
        <field name="model">fleet.vehicle</field>
        <field name="priority" eval="40"/>
        <field name="arch" type="xml">
            <form string="Vehículo monitoreado">
                <header groups="uta_transport_monitor.group_transport_manager">
                    <button name="action_sync_gps_positions" type="object" string="Sincronizar GPS" class="btn-primary"
                            attrs="{'invisible': [('traccar_unique_id', '=', False)]}"/>
                    <button name="action_test_traccar_connection" type="object" string="Probar conexión GPS" class="btn-secondary"
                            attrs="{'invisible': [('traccar_unique_id', '=', False)]}"/>
                    <button name="action_generate_secure_unique_id" type="object" string="Generar identificador seguro" class="btn-secondary"
                            attrs="{'invisible': [('traccar_unique_id', '!=', False)]}"/>
                </header>
                <sheet>
                    <field name="id" invisible="1"/>
                    <div class="oe_button_box" name="button_box" attrs="{'invisible': [('id', '=', False)]}">
                        <button name="action_view_positions" type="object" class="oe_stat_button" icon="fa-location-arrow">
                            <field name="position_count" widget="statinfo" string="Posiciones GPS"/>
                        </button>
                        <button name="action_view_trips" type="object" class="oe_stat_button" icon="fa-road">
                            <field name="trip_count" widget="statinfo" string="Recorridos"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="operational_name" string="Nombre operativo de la unidad"/>
                        <h1>
                            <field name="operational_name" placeholder="Ej. Unidad 01"/>
                        </h1>
                    </div>
                    <div class="alert alert-info mb-3" role="status"
                         groups="uta_transport_monitor.group_transport_manager"
                         attrs="{'invisible': [('traccar_unique_id', '!=', False)]}">
                        <strong>Vincule el GPS de esta unidad:</strong>
                        guarde el vehículo, pulse «Generar identificador seguro» e ingrese ese identificador
                        en la app Traccar Client del teléfono que irá en el vehículo.
                    </div>
                    <field name="gps_connection_status" invisible="1"/>
                    <div class="alert alert-info mb-3" role="status"
                         groups="uta_transport_monitor.group_transport_manager"
                         attrs="{'invisible': [('gps_connection_status', '!=', 'waiting')]}">
                        <strong>Siguiente paso: recibir la primera posición.</strong>
                        En el teléfono del vehículo abra Traccar Client, escriba el
                        <em>identificador de dispositivo</em> de esta unidad, configure la dirección del servidor GPS
                        y active el servicio. Luego pulse «Sincronizar GPS».
                    </div>
                    <group>
                        <group string="Datos del vehículo">
                            <field name="model_id" string="Modelo"/>
                            <field name="license_plate" string="Placa"/>
                            <field name="driver_id" string="Conductor asignado"/>
                        </group>
                        <group string="Configuración de rastreo GPS">
                            <field name="gps_tracking_enabled" string="Rastreo GPS activo" widget="boolean_toggle"/>
                            <field name="traccar_unique_id" string="Identificador de dispositivo"/>
                            <field name="traccar_device_id" string="ID interno de servidor GPS" groups="uta_transport_monitor.group_transport_manager" attrs="{'invisible': [('traccar_device_id', '=', 0)]}"/>
                            <field name="is_physical_accredited" string="Dispositivo físico acreditado" widget="boolean_toggle"/>
                            <field name="is_simulated" string="Unidad de simulación" widget="boolean_toggle"/>
                        </group>
                    </group>
                    <notebook attrs="{'invisible': [('id', '=', False)]}">
                        <page string="Telemetría reciente" name="georutex_telemetry">
                            <group>
                                <group string="Estado de señal">
                                    <field name="gps_connection_status" string="Conexión GPS" widget="badge"/>
                                    <field name="gps_freshness_state" string="Actualidad de la señal" widget="badge"/>
                                    <field name="last_gps_time_local" string="Último reporte"/>
                                    <field name="last_gps_speed" string="Velocidad (km/h)"/>
                                </group>
                                <group string="Última ubicación">
                                    <field name="last_gps_latitude" string="Latitud"
                                           attrs="{'invisible': [('last_gps_latitude', '=', 0), ('last_gps_longitude', '=', 0)]}"/>
                                    <field name="last_gps_longitude" string="Longitud"
                                           attrs="{'invisible': [('last_gps_latitude', '=', 0), ('last_gps_longitude', '=', 0)]}"/>
                                    <div class="text-muted small py-1" colspan="2"
                                         attrs="{'invisible': ['|', ('last_gps_latitude', '!=', 0), ('last_gps_longitude', '!=', 0)]}">
                                        Aún no se ha recibido ninguna posición de este vehículo.
                                    </div>
                                </group>
                            </group>
                        </page>
                        <page string="Ubicación en vivo" name="vehicle_live_map">
                            <field name="id" widget="vehicle_map_widget" nolabel="1"/>
                        </page>
                        <page string="Recorridos asignados" name="georutex_trips">
                            <field name="trip_ids" readonly="1">
                                <tree string="Recorridos">
                                    <field name="name" string="Código"/>
                                    <field name="route_id" string="Ruta"/>
                                    <field name="scheduled_start_utc" string="Inicio previsto"/>
                                    <field name="source_type" string="Fuente" widget="badge"/>
                                    <field name="state" string="Estado" widget="badge"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Dedicated GeoRutex Monitored Fleet Action -->
    <record id="action_transport_monitored_fleet" model="ir.actions.act_window">
        <field name="name">Vehículos</field>
        <field name="res_model">fleet.vehicle</field>
        <field name="view_mode">tree,form</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'tree', 'view_id': ref('view_georutex_monitored_fleet_tree')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_georutex_monitored_fleet_form')})]"/>
        <field name="context">{'search_default_filter_gps_monitored': 1}</field>
        <field name="help" type="html">
            <div class="grx-nocontent">
                <div class="grx-nocontent-icon grx-nc-bus"/>
                <h3>Sin vehículos monitoreados</h3>
                <p>Pulse «Nuevo» para registrar una unidad. Luego vincule su GPS desde el mismo formulario.</p>
            </div>
        </field>
    </record>
</odoo>
