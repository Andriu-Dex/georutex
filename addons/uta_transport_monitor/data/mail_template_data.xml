<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- 1. Verificación de correo electrónico (OTP de 6 dígitos) -->
    <record id="mail_template_georutex_email_verification" model="mail.template">
        <field name="name">GeoRutex: Verificación de correo electrónico</field>
        <field name="model_id" ref="model_transport_email_verification"/>
        <field name="subject">GeoRutex — Tu código de verificación ({{ ctx.get('otp_code', '') }})</field>
        <field name="email_to">{{ object.email }}</field>
        <field name="auto_delete" eval="True"/>
        <field name="body_html" type="html">
<div style="margin:0;padding:32px 16px;background-color:#f9f8f4;font-family:'Segoe UI',-apple-system,BlinkMacSystemFont,Roboto,Helvetica,Arial,sans-serif;color:#111827;">
    <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="max-width:560px;margin:0 auto;background-color:#ffffff;border-radius:16px;border:1px solid #e5e7eb;overflow:hidden;">
        <tr>
            <td style="height:4px;background-color:#1a56db;font-size:0;line-height:0;">&#160;</td>
        </tr>
        <tr>
            <td style="padding:28px 32px 20px;border-bottom:1px solid #f1efe9;">
                <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0">
                    <tr>
                        <td width="44" valign="middle" style="padding-right:12px;">
                            <img t-att-src="'%s/uta_transport_monitor/static/src/img/georutex_brand_mark.png' % ctx.get('georutex_base_url', '')" alt="GeoRutex" width="38" height="38" style="display:block;border:0;outline:none;text-decoration:none;"/>
                        </td>
                        <td valign="middle">
                            <div style="font-size:18px;font-weight:700;letter-spacing:-0.3px;color:#111827;line-height:1.15;">GeoRutex</div>
                            <div style="font-size:12px;color:#475569;margin-top:2px;">Inteligencia para la movilidad</div>
                        </td>
                    </tr>
                </table>
            </td>
        </tr>
        <tr>
            <td style="padding:28px 32px 24px;">
                <h1 style="margin:0 0 12px;font-size:22px;font-weight:700;letter-spacing:-0.4px;color:#111827;line-height:1.25;">
                    Verifica tu correo electrónico
                </h1>
                <p style="margin:0 0 14px;font-size:15px;line-height:1.6;color:#334155;">
                    Hola, <strong style="color:#111827;"><t t-out="object.full_name"/></strong>:
                </p>
                <p style="margin:0 0 22px;font-size:14px;line-height:1.65;color:#475569;">
                    Para activar tu cuenta en <strong>GeoRutex</strong>, ingresa el siguiente código de verificación de <strong>6 dígitos</strong>:
                </p>

                <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="margin:0 0 22px;background-color:#f9f8f4;border:1px solid #d5e3fb;border-radius:12px;">
                    <tr>
                        <td align="center" style="padding:22px 16px;">
                            <div style="font-size:11px;font-weight:700;letter-spacing:1.4px;text-transform:uppercase;color:#1a56db;margin-bottom:8px;">
                                Código de verificación
                            </div>
                            <div style="font-size:34px;font-weight:700;letter-spacing:10px;color:#111827;font-family:'Cascadia Mono','SFMono-Regular',Consolas,'Courier New',monospace;padding-left:10px;">
                                <t t-out="ctx.get('otp_code', '000000')"/>
                            </div>
                        </td>
                    </tr>
                </table>

                <t t-if="ctx.get('georutex_verify_url')">
                    <table role="presentation" cellspacing="0" cellpadding="0" border="0" style="margin:0 0 20px;">
                        <tr>
                            <td align="center" bgcolor="#1a56db" style="border-radius:10px;">
                                <a t-att-href="ctx.get('georutex_verify_url')" target="_blank" style="display:inline-block;padding:12px 22px;font-size:14px;font-weight:600;color:#ffffff;text-decoration:none;">
                                    Ir a verificar mi correo
                                </a>
                            </td>
                        </tr>
                    </table>
                </t>

                <p style="margin:0 0 16px;font-size:13px;line-height:1.6;color:#475569;">
                    Este código es personal, de un solo uso y tiene una validez de <strong style="color:#111827;"><t t-out="ctx.get('otp_expiry_minutes', 10)"/> minutos</strong>. No lo compartas con nadie.
                </p>

                <div style="padding:14px 16px;background-color:#f9f8f4;border-left:3px solid #0bbcd7;border-radius:6px;font-size:12px;line-height:1.55;color:#475569;">
                    Si no solicitaste crear una cuenta en GeoRutex, puedes ignorar este correo de forma segura.
                </div>
            </td>
        </tr>
        <tr>
            <td style="padding:18px 32px;background-color:#f9f8f4;border-top:1px solid #f1efe9;font-size:12px;line-height:1.5;color:#64748b;text-align:center;">
                GeoRutex · Plataforma de gestión y monitoreo de movilidad<br/>
                Este es un mensaje automático; por favor no respondas a este correo.
            </td>
        </tr>
    </table>
</div>
        </field>
    </record>

    <!-- 2. Recuperación y restablecimiento de contraseña -->
    <record id="mail_template_georutex_reset_password" model="mail.template">
        <field name="name">GeoRutex: Recuperación de contraseña</field>
        <field name="model_id" ref="base.model_res_users"/>
        <field name="subject">GeoRutex — Instrucciones para restablecer tu contraseña</field>
        <field name="email_to">{{ object.email_formatted }}</field>
        <field name="auto_delete" eval="True"/>
        <field name="body_html" type="html">
<div style="margin:0;padding:32px 16px;background-color:#f9f8f4;font-family:'Segoe UI',-apple-system,BlinkMacSystemFont,Roboto,Helvetica,Arial,sans-serif;color:#111827;">
    <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="max-width:560px;margin:0 auto;background-color:#ffffff;border-radius:16px;border:1px solid #e5e7eb;overflow:hidden;">
        <tr>
            <td style="height:4px;background-color:#1a56db;font-size:0;line-height:0;">&#160;</td>
        </tr>
        <tr>
            <td style="padding:28px 32px 20px;border-bottom:1px solid #f1efe9;">
                <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0">
                    <tr>
                        <td width="44" valign="middle" style="padding-right:12px;">
                            <img t-att-src="'%s/uta_transport_monitor/static/src/img/georutex_brand_mark.png' % ctx.get('georutex_base_url', '')" alt="GeoRutex" width="38" height="38" style="display:block;border:0;outline:none;text-decoration:none;"/>
                        </td>
                        <td valign="middle">
                            <div style="font-size:18px;font-weight:700;letter-spacing:-0.3px;color:#111827;line-height:1.15;">GeoRutex</div>
                            <div style="font-size:12px;color:#475569;margin-top:2px;">Inteligencia para la movilidad</div>
                        </td>
                    </tr>
                </table>
            </td>
        </tr>
        <tr>
            <td style="padding:28px 32px 24px;">
                <h1 style="margin:0 0 12px;font-size:22px;font-weight:700;letter-spacing:-0.4px;color:#111827;line-height:1.25;">
                    Restablece tu contraseña
                </h1>
                <p style="margin:0 0 14px;font-size:15px;line-height:1.6;color:#334155;">
                    Hola, <strong style="color:#111827;"><t t-out="object.name or ''"/></strong>:
                </p>
                <p style="margin:0 0 22px;font-size:14px;line-height:1.65;color:#475569;">
                    Recibimos una solicitud para restablecer la contraseña de tu cuenta en <strong>GeoRutex</strong>. Usa el siguiente botón para definir una nueva contraseña:
                </p>

                <table role="presentation" cellspacing="0" cellpadding="0" border="0" style="margin:0 0 22px;">
                    <tr>
                        <td align="center" bgcolor="#1a56db" style="border-radius:10px;">
                            <a t-att-href="ctx.get('georutex_reset_url') or object.signup_url" target="_blank" style="display:inline-block;padding:13px 24px;font-size:14px;font-weight:600;color:#ffffff;text-decoration:none;">
                                Restablecer contraseña
                            </a>
                        </td>
                    </tr>
                </table>

                <p style="margin:0 0 14px;font-size:13px;line-height:1.6;color:#475569;">
                    Por seguridad, este enlace es de <strong>un solo uso</strong> y permanecerá activo durante <strong>24 horas</strong>.
                </p>

                <div style="margin:0 0 18px;padding:12px 14px;background-color:#f9f8f4;border:1px solid #e5e7eb;border-radius:8px;font-size:12px;line-height:1.55;color:#475569;word-break:break-all;">
                    Si el botón no funciona, copia y pega este enlace en tu navegador:<br/>
                    <a t-att-href="ctx.get('georutex_reset_url') or object.signup_url" style="color:#1a56db;text-decoration:underline;">
                        <t t-out="ctx.get('georutex_reset_url') or object.signup_url"/>
                    </a>
                </div>

                <div style="padding:14px 16px;background-color:#f9f8f4;border-left:3px solid #fc0154;border-radius:6px;font-size:12px;line-height:1.55;color:#475569;">
                    Si no solicitaste este cambio, ignora este mensaje. Tu contraseña actual seguirá vigente y nadie podrá modificarla sin este enlace.
                </div>
            </td>
        </tr>
        <tr>
            <td style="padding:18px 32px;background-color:#f9f8f4;border-top:1px solid #f1efe9;font-size:12px;line-height:1.5;color:#64748b;text-align:center;">
                GeoRutex · Plataforma de gestión y monitoreo de movilidad<br/>
                Este es un mensaje automático; por favor no respondas a este correo.
            </td>
        </tr>
    </table>
</div>
        </field>
    </record>

    <!-- 3. Invitación / configuración inicial de contraseña para nuevas cuentas -->
    <record id="mail_template_georutex_set_password" model="mail.template">
        <field name="name">GeoRutex: Activación de cuenta</field>
        <field name="model_id" ref="base.model_res_users"/>
        <field name="subject">GeoRutex — Activa tu acceso a la plataforma</field>
        <field name="email_to">{{ object.email_formatted }}</field>
        <field name="auto_delete" eval="True"/>
        <field name="body_html" type="html">
<div style="margin:0;padding:32px 16px;background-color:#f9f8f4;font-family:'Segoe UI',-apple-system,BlinkMacSystemFont,Roboto,Helvetica,Arial,sans-serif;color:#111827;">
    <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="max-width:560px;margin:0 auto;background-color:#ffffff;border-radius:16px;border:1px solid #e5e7eb;overflow:hidden;">
        <tr>
            <td style="height:4px;background-color:#1a56db;font-size:0;line-height:0;">&#160;</td>
        </tr>
        <tr>
            <td style="padding:28px 32px 20px;border-bottom:1px solid #f1efe9;">
                <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0">
                    <tr>
                        <td width="44" valign="middle" style="padding-right:12px;">
                            <img t-att-src="'%s/uta_transport_monitor/static/src/img/georutex_brand_mark.png' % ctx.get('georutex_base_url', '')" alt="GeoRutex" width="38" height="38" style="display:block;border:0;outline:none;text-decoration:none;"/>
                        </td>
                        <td valign="middle">
                            <div style="font-size:18px;font-weight:700;letter-spacing:-0.3px;color:#111827;line-height:1.15;">GeoRutex</div>
                            <div style="font-size:12px;color:#475569;margin-top:2px;">Inteligencia para la movilidad</div>
                        </td>
                    </tr>
                </table>
            </td>
        </tr>
        <tr>
            <td style="padding:28px 32px 24px;">
                <h1 style="margin:0 0 12px;font-size:22px;font-weight:700;letter-spacing:-0.4px;color:#111827;line-height:1.25;">
                    Te damos la bienvenida a GeoRutex
                </h1>
                <p style="margin:0 0 14px;font-size:15px;line-height:1.6;color:#334155;">
                    Hola, <strong style="color:#111827;"><t t-out="object.name or ''"/></strong>:
                </p>
                <p style="margin:0 0 22px;font-size:14px;line-height:1.65;color:#475569;">
                    Se ha creado tu cuenta en <strong>GeoRutex</strong>. Define tu contraseña personal para ingresar a tu espacio de trabajo:
                </p>

                <table role="presentation" cellspacing="0" cellpadding="0" border="0" style="margin:0 0 22px;">
                    <tr>
                        <td align="center" bgcolor="#1a56db" style="border-radius:10px;">
                            <a t-att-href="ctx.get('georutex_reset_url') or object.signup_url" target="_blank" style="display:inline-block;padding:13px 24px;font-size:14px;font-weight:600;color:#ffffff;text-decoration:none;">
                                Configurar contraseña
                            </a>
                        </td>
                    </tr>
                </table>

                <div style="margin:0 0 18px;padding:12px 14px;background-color:#f9f8f4;border:1px solid #e5e7eb;border-radius:8px;font-size:12px;line-height:1.55;color:#475569;word-break:break-all;">
                    Enlace de acceso directo:<br/>
                    <a t-att-href="ctx.get('georutex_reset_url') or object.signup_url" style="color:#1a56db;text-decoration:underline;">
                        <t t-out="ctx.get('georutex_reset_url') or object.signup_url"/>
                    </a>
                </div>

                <div style="padding:14px 16px;background-color:#f9f8f4;border-left:3px solid #0bbcd7;border-radius:6px;font-size:12px;line-height:1.55;color:#475569;">
                    Tu correo de inicio de sesión es <strong style="color:#111827;"><t t-out="object.login or object.email"/></strong>. Por seguridad, no compartas este enlace.
                </div>
            </td>
        </tr>
        <tr>
            <td style="padding:18px 32px;background-color:#f9f8f4;border-top:1px solid #f1efe9;font-size:12px;line-height:1.5;color:#64748b;text-align:center;">
                GeoRutex · Plataforma de gestión y monitoreo de movilidad<br/>
                Este es un mensaje automático; por favor no respondas a este correo.
            </td>
        </tr>
    </table>
</div>
        </field>
    </record>
</odoo>
