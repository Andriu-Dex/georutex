<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_transport" model="ir.module.category">
        <field name="name">GeoRutex Transporte</field>
        <field name="description">Control de acceso y roles para monitoreo de transporte y rutas</field>
        <field name="sequence">25</field>
    </record>

    <!-- Rol: Consultor / Analista -->
    <record id="group_transport_analyst" model="res.groups">
        <field name="name">Analista / Consultor</field>
        <field name="category_id" ref="module_category_transport"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <!-- Rol: Conductor -->
    <record id="group_transport_driver" model="res.groups">
        <field name="name">Conductor</field>
        <field name="category_id" ref="module_category_transport"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <!-- Rol: Administrador de Transporte -->
    <record id="group_transport_manager" model="res.groups">
        <field name="name">Administrador de Transporte</field>
        <field name="category_id" ref="module_category_transport"/>
        <field name="implied_ids" eval="[(4, ref('group_transport_analyst')), (4, ref('fleet.fleet_group_manager'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
</odoo>

