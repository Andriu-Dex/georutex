        <field name="groups" eval="[(4, ref('group_transport_driver'))]"/>
        <field name="domain_force">['|', ('driver_user_id', '=', user.id), ('driver_id', '=', user.partner_id.id)]</field>
        <field name="perm_read" eval="True"/>
