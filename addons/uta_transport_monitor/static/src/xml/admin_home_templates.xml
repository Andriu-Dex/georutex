<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="uta_transport_monitor.GeoRutexAdminHomeAction" owl="1">
        <div class="grx-ops-page grx-admin-home" t-ref="adminHomeRoot">
            <div class="grx-ops-container">
                <!-- 1. COMPACT PREMIUM LIGHT COMMAND HEADER -->
                <header class="grx-page-header grx-page-header--compact">
                    <div class="grx-page-heading">
                        <div class="grx-eyebrow">
                            <span>Centro de operaciones</span>
                            <span t-if="state.localDateLabel" class="grx-eyebrow-sep">·</span>
                            <span t-if="state.localDateLabel"><t t-esc="state.localDateLabel"/></span>
                        </div>
                        <h1 class="grx-page-title">Supervisión de flota</h1>
                    </div>
                    <div class="grx-header-actions">
                        <span class="grx-status-chip" title="Unidades con señal GPS activa">
                            <span t-attf-class="grx-dot #{state.traccar.has_signal ? 'is-green is-pulse' : 'is-amber'}"/>
                            <span>GPS <strong class="grx-num"><t t-esc="state.traccar.online_ratio"/></strong></span>
                        </span>
                        <span class="grx-status-chip grx-num">
                            <i class="fa fa-clock-o" aria-hidden="true"/>
                            <span><t t-esc="state.localTimeLabel || 'ECT'"/></span>
                        </span>
                        <button type="button"
                                class="grx-btn"
                                t-on-click="() => this.syncTraccarFleet()"
                                t-att-disabled="state.isSyncing">
                            <i t-attf-class="fa #{state.isSyncing ? 'fa-spinner fa-spin' : 'fa-refresh'}" aria-hidden="true"/>
                            <span>Sincronizar GPS</span>
                        </button>
                        <button type="button"
                                class="grx-btn grx-btn--icon"
                                t-on-click="() => this.loadAdminHome(true)"
                                t-att-disabled="state.isLoading"
                                title="Actualizar panel"
                                aria-label="Actualizar panel">
                            <i t-attf-class="fa fa-repeat #{state.isLoading ? 'fa-spin' : ''}" aria-hidden="true"/>
                        </button>
                        <button type="button"
                                class="grx-btn grx-btn--primary"
                                t-on-click="() => this.openNewTrip()">
                            <i class="fa fa-plus" aria-hidden="true"/>
                            <span>Nuevo recorrido</span>
                        </button>
                    </div>
                </header>

                <!-- Error Alert State -->
                <div t-if="state.error" class="grx-alert-error" role="alert">
                    <span><i class="fa fa-exclamation-triangle me-2" aria-hidden="true"/><t t-esc="state.error"/></span>
                    <button type="button" class="grx-btn grx-btn--sm" t-on-click="() => this.loadAdminHome(false)">Reintentar</button>
                </div>

                <section t-if="showSetupGuide" class="grx-surface-panel grx-setup-guide" aria-labelledby="grx-setup-guide-title">
                    <div class="grx-panel-head">
                        <div class="grx-card-title-wrap">
                            <h2 id="grx-setup-guide-title" class="grx-panel-title">Primeros pasos</h2>
                            <span class="grx-pill is-blue grx-num"><t t-esc="setupDoneCount"/> de <t t-esc="state.setupSteps.length"/> completados</span>
                        </div>
                        <p class="grx-setup-guide-lead">Complete estos pasos en orden para empezar a monitorear recorridos.</p>
                    </div>
                    <ol class="grx-setup-steps">
                        <li t-foreach="state.setupSteps" t-as="step" t-key="step.key"
                            t-attf-class="grx-setup-step #{step.done ? 'is-done' : ''} #{step.key === nextSetupKey ? 'is-next' : ''}">
                            <span class="grx-setup-step-mark" aria-hidden="true">
                                <i t-if="step.done" class="fa fa-check"/>
                                <t t-else="" t-esc="step_index + 1"/>
                            </span>
                            <div class="grx-setup-step-body">
                                <strong><t t-esc="step.title"/></strong>
                                <span t-if="!step.done"><t t-esc="step.hint"/></span>
                                <span t-else="" class="visually-hidden">Completado</span>
                            </div>
                            <button t-if="!step.done" type="button"
                                    t-attf-class="grx-btn grx-btn--sm #{step.key === nextSetupKey ? 'grx-btn--primary' : ''}"
                                    t-on-click="() => this.runSetupStep(step)">
                                <t t-if="step.key === nextSetupKey">Empezar</t>
                                <t t-else="">Ir</t>
                            </button>
                        </li>
                    </ol>
                </section>

                <!-- 2. PREMIUM LIGHT OPERATIONAL KPI BAND (5 operational indicators; MT-01/02 live in Performance section) -->
                <section class="grx-ops-kpi-band grx-ops-kpi-band--five" aria-label="Indicadores operativos principales">
                    <button type="button" class="grx-band-cell grx-band-cell--anchor-light" t-on-click="() => this.openFleet()">
                        <div class="grx-band-head">
                            <span>Flota en línea</span>
                            <span t-attf-class="grx-dot #{!state.stats.vehicles_total ? 'is-muted' : (state.stats.vehicles_online ? 'is-green is-pulse' : 'is-amber')}"/>
                        </div>
                        <div class="grx-band-val grx-num">
                            <t t-if="state.stats.vehicles_tracked">
                                <t t-esc="state.stats.vehicles_online"/><span class="grx-band-denom">/<t t-esc="state.stats.vehicles_tracked"/></span>
                            </t>
                            <t t-else="">Sin datos</t>
                        </div>
                        <div class="grx-band-foot">
                            <span t-if="state.stats.vehicles_total"><t t-esc="state.stats.vehicles_total"/> unidades</span>
                            <span t-else="">Sin vehículos</span>
                            <strong t-if="state.stats.vehicles_tracked" class="grx-num"><t t-esc="this.fleetOnlinePct"/>%</strong>
                        </div>
                    </button>

                    <button type="button" class="grx-band-cell" t-on-click="() => this.openTrips()">
                        <div class="grx-band-head">
                            <span>En operación</span>
                        </div>
                        <div class="grx-band-val grx-num" data-grx-counter="1"><t t-esc="state.stats.trips_active"/></div>
                        <div class="grx-band-foot">
                            <span>Recorridos activos ahora</span>
                        </div>
                    </button>

                    <button type="button" class="grx-band-cell" t-on-click="() => this.openTrips()">
                        <div class="grx-band-head">
                            <span>Recorridos hoy</span>
                        </div>
                        <div class="grx-band-val grx-num" data-grx-counter="1"><t t-esc="state.stats.trips_today"/></div>
                        <div class="grx-band-foot">
                            <span>Agenda del día</span>
                        </div>
                    </button>

                    <button type="button" class="grx-band-cell" t-on-click="() => this.openRoutes()">
                        <div class="grx-band-head">
                            <span>Rutas activas</span>
                        </div>
                        <div class="grx-band-val grx-num" data-grx-counter="1"><t t-esc="state.stats.routes_active"/></div>
                        <div class="grx-band-foot">
                            <span><t t-esc="state.stats.stops_total"/> puntos de control</span>
                        </div>
                    </button>

                    <button type="button"
                            t-attf-class="grx-band-cell #{state.stats.incidents_open ? 'grx-band-cell--attention' : ''}"
                            t-on-click="() => this.openIncidents()">
                        <div class="grx-band-head">
                            <span>Incidencias abiertas</span>
                            <span t-attf-class="grx-dot #{state.stats.incidents_open ? 'is-red' : 'is-green'}"/>
                        </div>
                        <div class="grx-band-val grx-num" data-grx-counter="1"><t t-esc="state.stats.incidents_open"/></div>
                        <div class="grx-band-foot">
                            <span t-if="state.stats.incidents_critical"><t t-esc="state.stats.incidents_critical"/> críticas / altas</span>
                            <span t-else="">Sin alertas críticas</span>
                        </div>
                    </button>
                </section>

                <!-- 3. ASYMMETRIC COMMAND STAGE: PROTAGONIST LIVE MAP + UNIFIED FLEET CONSOLE -->
                <section class="grx-ops-command-stage" aria-label="Mapa de flota y estado de unidades">
                    <div class="grx-surface-panel grx-ops-map-panel">
                        <div class="grx-panel-head">
                            <div class="grx-card-title-wrap">
                                <h2 class="grx-panel-title">Mapa de flota en vivo</h2>
                                <span class="grx-pill is-blue grx-num"><t t-esc="this.positionedVehicleCount"/> ubicadas</span>
                            </div>
                            <div class="grx-card-controls">
                                <div class="grx-segmented" role="group" aria-label="Filtrar unidades en mapa">
                                    <button type="button" t-att-class="state.vehicleFilter === 'all' ? 'is-active' : ''" t-on-click="() => this.setVehicleFilter('all')">Todas</button>
                                    <button type="button" t-att-class="state.vehicleFilter === 'fresh' ? 'is-active' : ''" t-on-click="() => this.setVehicleFilter('fresh')">En línea</button>
                                    <button type="button" t-att-class="state.vehicleFilter === 'offline' ? 'is-active' : ''" t-on-click="() => this.setVehicleFilter('offline')">Sin señal</button>
                                </div>
                                <button type="button" class="grx-btn grx-btn--sm grx-btn--icon" t-on-click="() => this.recenterMap()" title="Reencuadrar mapa" aria-label="Reencuadrar mapa">
                                    <i class="fa fa-crosshairs" aria-hidden="true"/>
                                </button>
                                <button type="button" class="grx-btn grx-btn--sm" t-on-click="() => this.openLiveMap()">
                                    <span>Mapa completo</span>
                                    <i class="fa fa-external-link" aria-hidden="true"/>
                                </button>
                            </div>
                        </div>

                        <div class="grx-map-wrap grx-map-wrap--command">
                            <div t-ref="adminMapCanvas" class="grx-map-canvas"/>
                            <div class="grx-map-search-overlay">
                                <i class="fa fa-search" aria-hidden="true"/>
                                <input type="search"
                                       placeholder="Buscar unidad o placa..."
                                       t-model="state.vehicleSearch"
                                       t-on-input="() => this.onVehicleSearchInput()"
                                       aria-label="Buscar unidad en mapa"/>
                            </div>
                            <div class="grx-map-legend-pill">
                                <span><i class="grx-dot is-green"/> En línea (<t t-esc="state.stats.vehicles_online"/>)</span>
                                <span><i class="grx-dot is-amber"/> Reciente (<t t-esc="state.stats.vehicles_stale"/>)</span>
                                <span><i class="grx-dot is-red"/> Sin señal (<t t-esc="state.stats.vehicles_offline"/>)</span>
                            </div>
                            <div t-if="!this.positionedVehicleCount and !state.isLoading" class="grx-map-empty-overlay">
                                <strong>Sin coordenadas GPS activas</strong>
                                <div>Cuando los dispositivos vinculados envíen telemetría, las unidades aparecerán aquí automáticamente.</div>
                            </div>
                        </div>

                        <div class="grx-telemetry-footer">
                            <span class="grx-telemetry-foot-item">
                                <span class="grx-leg-line is-recorded" aria-hidden="true"/>
                                <span>Telemetría registrada: <strong class="grx-num"><t t-esc="state.stats.positions_total"/></strong> posiciones</span>
                            </span>
                            <span class="grx-telemetry-foot-item">
                                <span>Último reporte: <strong class="grx-num"><t t-esc="state.traccar.last_fix_local"/></strong></span>
                            </span>
                        </div>
                    </div>

                    <!-- Unified Right Contextual Fleet Console -->
                    <aside class="grx-surface-panel grx-ops-fleet-console" aria-label="Consola de flota y conectividad">
                        <div class="grx-panel-head">
                            <div>
                                <h2 class="grx-panel-title">Estado de la flota</h2>
                                <p class="grx-panel-sub">Selecciona una unidad para enfocarla en el mapa</p>
                            </div>
                            <button type="button" class="grx-btn grx-btn--sm" t-on-click="() => this.openFleet()">Ver flota</button>
                        </div>

                        <div class="grx-connectivity-strip">
                            <div class="grx-conn-cell">
                                <span class="grx-conn-label"><i class="grx-dot is-green"/> En línea</span>
                                <strong class="grx-num"><t t-esc="state.stats.vehicles_online"/></strong>
                            </div>
                            <div class="grx-conn-cell">
                                <span class="grx-conn-label"><i class="grx-dot is-amber"/> Reciente</span>
                                <strong class="grx-num"><t t-esc="state.stats.vehicles_stale"/></strong>
                            </div>
                            <div class="grx-conn-cell">
                                <span class="grx-conn-label"><i class="grx-dot is-red"/> Sin señal</span>
                                <strong class="grx-num"><t t-esc="state.stats.vehicles_offline"/></strong>
                            </div>
                            <div class="grx-conn-cell">
                                <span class="grx-conn-label"><i class="grx-dot is-blue"/> Simuladas</span>
                                <strong class="grx-num"><t t-esc="state.stats.vehicles_simulated"/></strong>
                            </div>
                        </div>

                        <div t-if="state.isLoading" class="grx-card-body grx-skeleton-stack">
                            <div class="grx-skeleton-line"/>
                            <div class="grx-skeleton-line is-short"/>
                            <div class="grx-skeleton-line"/>
                        </div>
                        <div t-elif="!this.filteredVehicles.length" class="grx-empty">
                            <i class="fa fa-bus" aria-hidden="true"/>
                            <strong>Sin unidades monitoreadas</strong>
                            <p>Vincula un vehículo con seguimiento GPS para supervisarlo en tiempo real.</p>
                        </div>
                        <div t-else="" class="grx-ledger-list" t-ref="adminVehiclesList">
                            <t t-foreach="this.filteredVehicles.slice(0, 6)" t-as="v" t-key="v.vehicle_id">
                                <div t-attf-class="grx-ledger-row #{state.selectedVehicleId === v.vehicle_id ? 'is-selected' : ''}"
                                     role="button" tabindex="0"
                                     t-on-click="() => this.focusVehicle(v)">
                                    <div class="grx-item-lead">
                                        <span t-attf-class="grx-dot #{this.getFreshnessDotClass(v.freshness)}"/>
                                        <div class="grx-item-text">
                                            <div class="grx-item-title"><t t-esc="v.name"/></div>
                                            <div class="grx-item-sub">
                                                <span class="grx-mono"><t t-esc="v.license_plate || 'S/P'"/></span> · <t t-esc="v.driver_name"/>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="grx-item-trail">
                                        <div class="grx-item-title grx-num">
                                            <t t-if="v.has_coordinates and (v.freshness === 'fresh' or v.freshness === 'online')">
                                                <t t-esc="Math.round(v.speed || 0)"/> km/h
                                            </t>
                                            <t t-else="">Sin datos</t>
                                        </div>
                                        <div class="grx-item-sub grx-num"><t t-esc="v.fix_time_local"/></div>
                                    </div>
                                </div>
                            </t>
                        </div>

                        <div t-if="state.routes.length" class="grx-console-footer">
                            <span class="grx-item-sub">
                                <strong class="grx-num"><t t-esc="state.routes.length"/></strong> rutas activas · <span class="grx-num"><t t-esc="state.stats.stops_total"/></span> paradas
                            </span>
                            <button type="button" class="grx-link-btn" t-on-click="() => this.openRoutes()">
                                Ver rutas <i class="fa fa-arrow-right" aria-hidden="true"/>
                            </button>
                        </div>
                    </aside>
                </section>

                <!-- 4. LOWER SPLIT: PRIORITY INCIDENTS + SERVICE PERFORMANCE (MT-01 & MT-02) -->
                <section class="grx-ops-lower-split">
                    <div class="grx-surface-panel">
                        <div class="grx-panel-head">
                            <div>
                                <h2 class="grx-panel-title">Incidencias prioritarias</h2>
                                <p class="grx-panel-sub">Eventos recientes que requieren seguimiento</p>
                            </div>
                            <div class="grx-card-controls">
                                <div class="grx-segmented" role="group" aria-label="Filtrar incidencias">
                                    <button type="button" t-att-class="state.incidentFilter === 'all' ? 'is-active' : ''" t-on-click="() => { state.incidentFilter = 'all'; }">Todas</button>
                                    <button type="button" t-att-class="state.incidentFilter === 'open' ? 'is-active' : ''" t-on-click="() => { state.incidentFilter = 'open'; }">Abiertas</button>
                                </div>
                                <button type="button" class="grx-btn grx-btn--sm" t-on-click="() => this.openIncidents()">Ver todas</button>
                            </div>
                        </div>
                        <div t-if="!this.filteredIncidents.length" class="grx-empty">
                            <i class="fa fa-check-circle" aria-hidden="true"/>
                            <strong>Sin incidencias pendientes</strong>
                            <p>No existen novedades operacionales para el filtro seleccionado.</p>
                        </div>
                        <div t-else="" class="grx-ledger-list">
                            <t t-foreach="this.filteredIncidents.slice(0, 5)" t-as="inc" t-key="inc.id">
                                <div class="grx-ledger-row" role="button" tabindex="0" t-on-click="() => this.openIncidentDetail(inc.id)">
                                    <div class="grx-item-text">
                                        <div class="grx-item-title"><t t-esc="inc.incident_type_label"/></div>
                                        <div class="grx-item-sub">
                                            <span class="grx-mono"><t t-esc="inc.name"/></span> · <span class="grx-mono"><t t-esc="inc.trip_name"/></span> · <t t-esc="inc.timestamp_local"/>
                                        </div>
                                    </div>
                                    <span t-attf-class="grx-pill #{this.getSeverityBadgeClass(inc.severity)}">
                                        <t t-esc="inc.severity_label"/>
                                    </span>
                                </div>
                            </t>
                        </div>
                    </div>

                    <div class="grx-surface-panel">
                        <div class="grx-panel-head">
                            <div>
                                <h2 class="grx-panel-title">Rendimiento del servicio</h2>
                                <p class="grx-panel-sub">
                                    Cumplimiento <span class="grx-mono">MT-01</span>: <strong class="grx-num"><t t-esc="state.kpis.mt01.display_value"/></strong>
                                    · Puntualidad <span class="grx-mono">MT-02</span>: <strong class="grx-num"><t t-esc="state.kpis.mt02.display_value"/></strong>
                                </p>
                            </div>
                            <button type="button" class="grx-btn grx-btn--sm" t-on-click="() => this.openDashboard()">
                                <span>Análisis completo</span>
                                <i class="fa fa-arrow-right" aria-hidden="true"/>
                            </button>
                        </div>
                        <div class="grx-card-body">
                            <div t-if="this.hasTrendData" t-ref="adminTrendCanvas" class="grx-echart-box" role="img" aria-label="Tendencia diaria de cumplimiento y puntualidad"/>
                            <div t-else="" class="grx-empty">
                                <i class="fa fa-bar-chart" aria-hidden="true"/>
                                <strong>Sin recorridos evaluados todavía</strong>
                                <p>Cuando finalices y evalúes recorridos, la tendencia real aparecerá aquí automáticamente.</p>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- 5. RECENT TRIPS LEDGER -->
                <section class="grx-surface-panel">
                    <div class="grx-panel-head">
                        <div>
                            <h2 class="grx-panel-title">Recorridos recientes</h2>
                            <p class="grx-panel-sub">Control operativo de salidas, asignación y telemetría</p>
                        </div>
                        <div class="grx-table-toolbar">
                            <input type="search"
                                   class="grx-search-input"
                                   placeholder="Buscar ruta, unidad o conductor..."
                                   t-model="state.tripSearch"
                                   aria-label="Buscar recorridos"/>
                            <div class="grx-segmented" role="group" aria-label="Filtrar estado de recorridos">
                                <button type="button" t-att-class="state.tripFilter === 'all' ? 'is-active' : ''" t-on-click="() => { state.tripFilter = 'all'; }">Todos</button>
                                <button type="button" t-att-class="state.tripFilter === 'in_progress' ? 'is-active' : ''" t-on-click="() => { state.tripFilter = 'in_progress'; }">En curso</button>
                                <button type="button" t-att-class="state.tripFilter === 'scheduled' ? 'is-active' : ''" t-on-click="() => { state.tripFilter = 'scheduled'; }">Programados</button>
                                <button type="button" t-att-class="state.tripFilter === 'completed' ? 'is-active' : ''" t-on-click="() => { state.tripFilter = 'completed'; }">Finalizados</button>
                            </div>
                            <button type="button" class="grx-btn grx-btn--sm" t-on-click="() => this.openTrips()">Ver todos</button>
                        </div>
                    </div>

                    <div t-if="!this.filteredTrips.length" class="grx-empty">
                        <i class="fa fa-road" aria-hidden="true"/>
                        <strong>No hay recorridos que coincidan</strong>
                        <p>Programa un nuevo recorrido operacional o limpia los filtros de búsqueda.</p>
                    </div>

                    <div t-else="" class="grx-table-wrap">
                        <table class="grx-table">
                            <thead>
                                <tr>
                                    <th>Ruta</th>
                                    <th>Código</th>
                                    <th>Vehículo</th>
                                    <th>Conductor</th>
                                    <th>Inicio (ECT)</th>
                                    <th>Fuente / GPS</th>
                                    <th>Estado</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="this.filteredTrips.slice(0, 8)" t-as="trip" t-key="trip.id">
                                    <tr t-on-click="() => this.openTripDetail(trip.id)">
                                        <td><strong><t t-esc="trip.route_name"/></strong></td>
                                        <td class="grx-mono grx-cell-muted"><t t-esc="trip.name"/></td>
                                        <td><t t-esc="trip.vehicle_name"/></td>
                                        <td><t t-esc="trip.driver_name"/></td>
                                        <td class="grx-num"><t t-esc="trip.scheduled_start_local"/></td>
                                        <td>
                                            <span t-if="trip.source_type === 'simulated'" class="grx-pill is-amber">Simulado</span>
                                            <span t-else="" class="grx-pill is-blue">Real</span>
                                            <span class="grx-num grx-item-sub ms-1"><t t-esc="trip.position_count"/> pts</span>
                                        </td>
                                        <td>
                                            <span t-attf-class="grx-pill #{this.getStateBadgeClass(trip.state)}">
                                                <t t-esc="trip.state_label"/>
                                            </span>
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </div>
                </section>
            </div>
        </div>
    </t>
</templates>
