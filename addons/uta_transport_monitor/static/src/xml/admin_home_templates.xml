<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="uta_transport_monitor.GeoRutexAdminHomeAction" owl="1">
        <div class="grx-ops-page grx-admin-home" t-ref="adminHomeRoot">
            <div class="grx-ops-container">
                <!-- 1. COMPACT PAGE HEADER -->
                <header class="grx-page-header">
                    <div class="grx-page-heading">
                        <div class="grx-eyebrow">
                            <span class="grx-eyebrow-dot" aria-hidden="true"/>
                            <span>Centro de operaciones</span>
                            <span t-if="state.localDateLabel" class="grx-eyebrow-sep">·</span>
                            <span t-if="state.localDateLabel"><t t-esc="state.localDateLabel"/></span>
                        </div>
                        <h1 class="grx-page-title">Panel operativo de flota</h1>
                    </div>
                    <div class="grx-header-actions">
                        <span class="grx-status-chip" title="Unidades con señal GPS activa">
                            <span t-attf-class="grx-dot #{state.traccar.has_signal ? 'is-green is-pulse' : 'is-amber'}"/>
                            <span>Señal GPS: <strong><t t-esc="state.traccar.online_ratio"/></strong></span>
                        </span>
                        <span class="grx-status-chip">
                            <i class="fa fa-clock-o" aria-hidden="true"/>
                            <span><t t-esc="state.localTimeLabel || 'ECT'"/></span>
                        </span>
                        <button type="button"
                                class="grx-btn"
                                t-on-click="() => this.syncTraccarFleet()"
                                t-att-disabled="state.isSyncing">
                            <i t-attf-class="fa #{state.isSyncing ? 'fa-spinner fa-spin' : 'fa-refresh'}" aria-hidden="true"/>
                            <span>Sincronizar GPS</span>
                        </button>
                        <button type="button"
                                class="grx-btn grx-btn--icon"
                                t-on-click="() => this.loadAdminHome(true)"
                                t-att-disabled="state.isLoading"
                                title="Actualizar panel"
                                aria-label="Actualizar panel">
                            <i t-attf-class="fa fa-repeat #{state.isLoading ? 'fa-spin' : ''}" aria-hidden="true"/>
                        </button>
                        <button type="button"
                                class="grx-btn grx-btn--primary"
                                t-on-click="() => this.openNewTrip()">
                            <i class="fa fa-plus" aria-hidden="true"/>
                            <span>Nuevo recorrido</span>
                        </button>
                    </div>
                </header>

                <!-- Error Alert State -->
                <div t-if="state.error" class="grx-alert-error" role="alert">
                    <span><i class="fa fa-exclamation-triangle me-2" aria-hidden="true"/><t t-esc="state.error"/></span>
                    <button type="button" class="grx-btn grx-btn--sm" t-on-click="() => this.loadAdminHome(false)">Reintentar</button>
                </div>

                <!-- 2. SIX SIMULTANEOUS REAL OPERATIONAL KPI CARDS -->
                <section class="grx-kpi-grid" aria-label="Indicadores operativos principales">
                    <article class="grx-kpi-card" role="button" tabindex="0" t-on-click="() => this.openFleet()">
                        <div class="grx-kpi-head">
                            <span>Flota en línea</span>
                            <span t-attf-class="grx-dot #{!state.stats.vehicles_total ? 'is-muted' : (state.stats.vehicles_online ? 'is-green is-pulse' : 'is-amber')}"/>
                        </div>
                        <div class="grx-kpi-val">
                            <t t-if="state.stats.vehicles_tracked">
                                <t t-esc="state.stats.vehicles_online"/> <span class="grx-kpi-denom">/ <t t-esc="state.stats.vehicles_tracked"/></span>
                            </t>
                            <t t-else="">N/A</t>
                        </div>
                        <div class="grx-kpi-foot">
                            <span t-if="state.stats.vehicles_total"><t t-esc="state.stats.vehicles_total"/> unidades registradas</span>
                            <span t-else="">Sin vehículos registrados</span>
                            <strong t-if="state.stats.vehicles_tracked" class="grx-num"><t t-esc="this.fleetOnlinePct"/>%</strong>
                        </div>
                        <div t-if="state.stats.vehicles_tracked" class="grx-progress-track"><div class="grx-progress-fill" t-attf-style="width: #{this.fleetOnlinePct}%;"/></div>
                    </article>

                    <article class="grx-kpi-card" role="button" tabindex="0" t-on-click="() => this.openRoutes()">
                        <div class="grx-kpi-head">
                            <span>Rutas activas</span>
                            <i class="fa fa-map-signs grx-kpi-ico" aria-hidden="true"/>
                        </div>
                        <div class="grx-kpi-val" data-grx-counter="1"><t t-esc="state.stats.routes_active"/></div>
                        <div class="grx-kpi-foot">
                            <span><t t-esc="state.stats.stops_total"/> puntos de control</span>
                        </div>
                    </article>

                    <article class="grx-kpi-card" role="button" tabindex="0" t-on-click="() => this.openTrips()">
                        <div class="grx-kpi-head">
                            <span>Recorridos de hoy</span>
                            <i class="fa fa-road grx-kpi-ico" aria-hidden="true"/>
                        </div>
                        <div class="grx-kpi-val" data-grx-counter="1"><t t-esc="state.stats.trips_today"/></div>
                        <div class="grx-kpi-foot">
                            <span><t t-esc="state.stats.trips_active"/> en operación</span>
                        </div>
                    </article>

                    <article class="grx-kpi-card" role="button" tabindex="0" t-on-click="() => this.openDashboard()">
                        <div class="grx-kpi-head">
                            <span>Cumplimiento de recorridos</span>
                            <span class="grx-code-tag">MT-01</span>
                        </div>
                        <div class="grx-kpi-val"><t t-esc="state.kpis.mt01.display_value"/></div>
                        <div class="grx-kpi-foot">
                            <span>Muestra n = <t t-esc="state.kpis.mt01.sample_size"/></span>
                        </div>
                    </article>

                    <article class="grx-kpi-card" role="button" tabindex="0" t-on-click="() => this.openDashboard()">
                        <div class="grx-kpi-head">
                            <span>Puntualidad</span>
                            <span class="grx-code-tag">MT-02</span>
                        </div>
                        <div class="grx-kpi-val"><t t-esc="state.kpis.mt02.display_value"/></div>
                        <div class="grx-kpi-foot">
                            <span>Muestra n = <t t-esc="state.kpis.mt02.sample_size"/></span>
                        </div>
                    </article>

                    <article class="grx-kpi-card" role="button" tabindex="0" t-on-click="() => this.openIncidents()">
                        <div class="grx-kpi-head">
                            <span>Incidencias abiertas</span>
                            <span t-attf-class="grx-dot #{state.stats.incidents_open ? 'is-red' : 'is-green'}"/>
                        </div>
                        <div class="grx-kpi-val" data-grx-counter="1"><t t-esc="state.stats.incidents_open"/></div>
                        <div class="grx-kpi-foot">
                            <span><t t-esc="state.stats.incidents_critical"/> críticas o altas</span>
                        </div>
                    </article>
                </section>

                <!-- 3. PROTAGONIST STAGE: LIVE MAP + FLEET SIDEBAR -->
                <section class="grx-ops-stage">
                    <div class="grx-card grx-card--map">
                        <div class="grx-card-header">
                            <div class="grx-card-title-wrap">
                                <h2 class="grx-card-title">
                                    <i class="fa fa-map-marker grx-ico-primary" aria-hidden="true"/>
                                    <span>Mapa de flota en tiempo real</span>
                                </h2>
                                <span class="grx-pill is-blue"><t t-esc="this.positionedVehicleCount"/> ubicadas</span>
                            </div>
                            <div class="grx-card-controls">
                                <div class="grx-segmented" role="group" aria-label="Filtrar unidades en mapa">
                                    <button type="button" t-att-class="state.vehicleFilter === 'all' ? 'is-active' : ''" t-on-click="() => this.setVehicleFilter('all')">Todas</button>
                                    <button type="button" t-att-class="state.vehicleFilter === 'fresh' ? 'is-active' : ''" t-on-click="() => this.setVehicleFilter('fresh')">En línea</button>
                                    <button type="button" t-att-class="state.vehicleFilter === 'offline' ? 'is-active' : ''" t-on-click="() => this.setVehicleFilter('offline')">Sin señal</button>
                                </div>
                                <button type="button" class="grx-btn grx-btn--sm grx-btn--icon" t-on-click="() => this.recenterMap()" title="Reencuadrar mapa" aria-label="Reencuadrar mapa">
                                    <i class="fa fa-crosshairs" aria-hidden="true"/>
                                </button>
                                <button type="button" class="grx-btn grx-btn--sm" t-on-click="() => this.openLiveMap()">
                                    <span>Pantalla completa</span>
                                    <i class="fa fa-external-link" aria-hidden="true"/>
                                </button>
                            </div>
                        </div>

                        <div class="grx-map-wrap">
                            <div t-ref="adminMapCanvas" class="grx-map-canvas"/>
                            <div class="grx-map-search-overlay">
                                <i class="fa fa-search" aria-hidden="true"/>
                                <input type="search"
                                       placeholder="Buscar unidad o placa..."
                                       t-model="state.vehicleSearch"
                                       t-on-input="() => this.onVehicleSearchInput()"
                                       aria-label="Buscar unidad en mapa"/>
                            </div>
                            <div class="grx-map-legend-pill">
                                <span><i class="grx-dot is-green"/> En línea (<t t-esc="state.stats.vehicles_online"/>)</span>
                                <span><i class="grx-dot is-amber"/> Reciente (<t t-esc="state.stats.vehicles_stale"/>)</span>
                                <span><i class="grx-dot is-red"/> Sin señal (<t t-esc="state.stats.vehicles_offline"/>)</span>
                            </div>
                            <div t-if="!this.positionedVehicleCount and !state.isLoading" class="grx-map-empty-overlay">
                                <strong>Sin coordenadas GPS activas</strong>
                                <div>Cuando los dispositivos vinculados envíen telemetría, las unidades aparecerán aquí automáticamente.</div>
                            </div>
                        </div>

                        <!-- Compact GeoRutex Vehicle Telemetry Strip -->
                        <div class="grx-vehicle-rail" aria-hidden="true">
                            <svg class="grx-vehicle-rail-svg" viewBox="0 0 1000 44" preserveAspectRatio="xMidYMid slice">
                                <line x1="0" y1="34" x2="1000" y2="34" stroke="#cbd5e1" stroke-width="1.5" stroke-dasharray="14 10" class="grx-road-dashes"/>
                                <g class="grx-bus-ltr">
                                    <g class="grx-bus-float">
                                        <rect x="8" y="12" width="62" height="20" rx="5" fill="#111827"/>
                                        <rect x="8" y="25" width="62" height="3" fill="#0bbcd7"/>
                                        <rect x="14" y="15" width="12" height="7" rx="1.5" fill="#ebf2ff"/>
                                        <rect x="29" y="15" width="12" height="7" rx="1.5" fill="#ebf2ff"/>
                                        <rect x="44" y="15" width="12" height="7" rx="1.5" fill="#ebf2ff"/>
                                        <rect x="59" y="15" width="8" height="7" rx="1.5" fill="#93c5fd"/>
                                        <circle cx="21" cy="33" r="4.5" fill="#111827" stroke="#e2e8f0" stroke-width="1.5"/>
                                        <circle cx="57" cy="33" r="4.5" fill="#111827" stroke="#e2e8f0" stroke-width="1.5"/>
                                    </g>
                                </g>
                            </svg>
                            <span class="grx-rail-meta">
                                <i class="fa fa-signal me-1"/> Telemetría: <strong t-esc="state.stats.positions_total"/> posiciones registradas
                            </span>
                            <span class="grx-rail-meta">
                                Último reporte: <strong t-esc="state.traccar.last_fix_local"/>
                            </span>
                        </div>
                    </div>

                    <!-- Right Stack: Fleet Summary + Vehicles + Routes -->
                    <div class="grx-ops-side-stack">
                        <div class="grx-card">
                            <div class="grx-card-header">
                                <h2 class="grx-card-title">
                                    <i class="fa fa-th-large grx-ico-primary" aria-hidden="true"/>
                                    <span>Estado de la flota</span>
                                </h2>
                                <button type="button" class="grx-btn grx-btn--sm" t-on-click="() => this.openFleet()">Ver flota</button>
                            </div>
                            <div class="grx-card-body">
                                <div class="grx-unit-grid">
                                    <div class="grx-unit-stat is-green">
                                        <span>En línea</span>
                                        <strong t-esc="state.stats.vehicles_online"/>
                                    </div>
                                    <div class="grx-unit-stat is-amber">
                                        <span>Reciente</span>
                                        <strong t-esc="state.stats.vehicles_stale"/>
                                    </div>
                                    <div class="grx-unit-stat is-red">
                                        <span>Sin señal</span>
                                        <strong t-esc="state.stats.vehicles_offline"/>
                                    </div>
                                    <div class="grx-unit-stat is-blue">
                                        <span>Simuladas</span>
                                        <strong t-esc="state.stats.vehicles_simulated"/>
                                    </div>
                                </div>
                                <div class="grx-unit-total">
                                    <span>Total flota activa</span>
                                    <strong t-esc="state.stats.vehicles_total"/>
                                </div>
                            </div>
                        </div>

                        <div class="grx-card">
                            <div class="grx-card-header">
                                <h2 class="grx-card-title">
                                    <i class="fa fa-bus grx-ico-primary" aria-hidden="true"/>
                                    <span>Vehículos monitoreados</span>
                                </h2>
                                <button type="button" class="grx-btn grx-btn--sm" t-on-click="() => this.openFleet()">Gestionar</button>
                            </div>
                            <div t-if="state.isLoading" class="grx-card-body grx-skeleton-stack">
                                <div class="grx-skeleton-line"/>
                                <div class="grx-skeleton-line is-short"/>
                                <div class="grx-skeleton-line"/>
                            </div>
                            <div t-elif="!this.filteredVehicles.length" class="grx-empty">
                                <i class="fa fa-bus" aria-hidden="true"/>
                                <strong>Sin unidades monitoreadas</strong>
                                <p>Vincula un vehículo con seguimiento GPS para supervisarlo en tiempo real.</p>
                            </div>
                            <div t-else="" class="grx-list-scroll">
                                <t t-foreach="this.filteredVehicles" t-as="v" t-key="v.vehicle_id">
                                    <div t-attf-class="grx-list-item #{state.selectedVehicleId === v.vehicle_id ? 'is-selected' : ''}"
                                         role="button" tabindex="0"
                                         t-on-click="() => this.focusVehicle(v)">
                                        <div class="grx-item-lead">
                                            <span t-attf-class="grx-dot #{this.getFreshnessDotClass(v.freshness)}"/>
                                            <div class="grx-item-text">
                                                <div class="grx-item-title"><t t-esc="v.name"/></div>
                                                <div class="grx-item-sub">
                                                    <t t-esc="v.license_plate || 'S/P'"/> · <t t-esc="v.driver_name"/>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="grx-item-trail">
                                            <div class="grx-item-title grx-num"><t t-esc="Math.round(v.speed || 0)"/> km/h</div>
                                            <div class="grx-item-sub"><t t-esc="v.fix_time_local"/></div>
                                        </div>
                                    </div>
                                </t>
                            </div>
                        </div>

                        <div class="grx-card grx-card--grow">
                            <div class="grx-card-header">
                                <h2 class="grx-card-title">
                                    <i class="fa fa-map-signs grx-ico-primary" aria-hidden="true"/>
                                    <span>Rutas y paradas</span>
                                </h2>
                                <button type="button" class="grx-btn grx-btn--sm" t-on-click="() => this.openRoutes()">Ver rutas</button>
                            </div>
                            <div t-if="!state.routes.length" class="grx-empty">
                                <i class="fa fa-map-o" aria-hidden="true"/>
                                <strong>Sin rutas configuradas</strong>
                                <p>Registra tus rutas de servicio y configura sus puntos de control.</p>
                            </div>
                            <div t-else="" class="grx-list-scroll grx-list-scroll--sm">
                                <t t-foreach="state.routes" t-as="rt" t-key="rt.id">
                                    <div class="grx-list-item" role="button" tabindex="0" t-on-click="() => this.openRouteDetail(rt.id)">
                                        <div class="grx-item-text">
                                            <div class="grx-item-title"><t t-esc="rt.name"/></div>
                                            <div class="grx-item-sub"><t t-esc="rt.origin_name"/> → <t t-esc="rt.destination_name"/></div>
                                        </div>
                                        <span class="grx-pill is-muted"><t t-esc="rt.stop_count"/> paradas</span>
                                    </div>
                                </t>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- 4. ANALYTICS PREVIEW & INCIDENTS ROW -->
                <section class="grx-two-col">
                    <div class="grx-card">
                        <div class="grx-card-header">
                            <h2 class="grx-card-title">
                                <i class="fa fa-line-chart grx-ico-primary" aria-hidden="true"/>
                                <span>Tendencia de cumplimiento y puntualidad</span>
                            </h2>
                            <button type="button" class="grx-btn grx-btn--sm" t-on-click="() => this.openDashboard()">
                                <span>Análisis completo</span>
                                <i class="fa fa-arrow-right" aria-hidden="true"/>
                            </button>
                        </div>
                        <div class="grx-card-body">
                            <div t-if="this.hasTrendData" t-ref="adminTrendCanvas" class="grx-echart-box" role="img" aria-label="Tendencia diaria de cumplimiento y puntualidad"/>
                            <div t-else="" class="grx-empty">
                                <i class="fa fa-bar-chart" aria-hidden="true"/>
                                <strong>Sin recorridos evaluados todavía</strong>
                                <p>Cuando finalices y evalúes recorridos, la tendencia real aparecerá aquí automáticamente.</p>
                            </div>
                        </div>
                    </div>

                    <div class="grx-card">
                        <div class="grx-card-header">
                            <h2 class="grx-card-title">
                                <i class="fa fa-exclamation-triangle grx-ico-primary" aria-hidden="true"/>
                                <span>Incidencias operacionales</span>
                            </h2>
                            <div class="grx-card-controls">
                                <div class="grx-segmented" role="group">
                                    <button type="button" t-att-class="state.incidentFilter === 'all' ? 'is-active' : ''" t-on-click="() => { state.incidentFilter = 'all'; }">Todas</button>
                                    <button type="button" t-att-class="state.incidentFilter === 'open' ? 'is-active' : ''" t-on-click="() => { state.incidentFilter = 'open'; }">Abiertas</button>
                                </div>
                                <button type="button" class="grx-btn grx-btn--sm" t-on-click="() => this.openNewIncident()">+ Nueva</button>
                            </div>
                        </div>
                        <div t-if="!this.filteredIncidents.length" class="grx-empty">
                            <i class="fa fa-check-circle" aria-hidden="true"/>
                            <strong>Sin incidencias registradas</strong>
                            <p>No existen novedades operacionales para el filtro seleccionado.</p>
                        </div>
                        <div t-else="" class="grx-list-scroll grx-list-scroll--md">
                            <t t-foreach="this.filteredIncidents" t-as="inc" t-key="inc.id">
                                <div class="grx-list-item" role="button" tabindex="0" t-on-click="() => this.openIncidentDetail(inc.id)">
                                    <div class="grx-item-text">
                                        <div class="grx-item-title">
                                            <t t-esc="inc.name"/> · <t t-esc="inc.incident_type_label"/>
                                        </div>
                                        <div class="grx-item-sub">
                                            <t t-esc="inc.trip_name"/> · <t t-esc="inc.timestamp_local"/>
                                        </div>
                                    </div>
                                    <span t-attf-class="grx-pill #{this.getSeverityBadgeClass(inc.severity)}">
                                        <t t-esc="inc.severity_label"/>
                                    </span>
                                </div>
                            </t>
                        </div>
                    </div>
                </section>

                <!-- 5. FILTERABLE RECENT TRIPS TABLE -->
                <section class="grx-card">
                    <div class="grx-card-header">
                        <h2 class="grx-card-title">
                            <i class="fa fa-list-alt grx-ico-primary" aria-hidden="true"/>
                            <span>Recorridos recientes</span>
                        </h2>
                        <div class="grx-table-toolbar">
                            <input type="search"
                                   class="grx-search-input"
                                   placeholder="Buscar ruta, unidad o conductor..."
                                   t-model="state.tripSearch"
                                   aria-label="Buscar recorridos"/>
                            <div class="grx-segmented" role="group" aria-label="Filtrar estado de recorridos">
                                <button type="button" t-att-class="state.tripFilter === 'all' ? 'is-active' : ''" t-on-click="() => { state.tripFilter = 'all'; }">Todos</button>
                                <button type="button" t-att-class="state.tripFilter === 'in_progress' ? 'is-active' : ''" t-on-click="() => { state.tripFilter = 'in_progress'; }">En curso</button>
                                <button type="button" t-att-class="state.tripFilter === 'scheduled' ? 'is-active' : ''" t-on-click="() => { state.tripFilter = 'scheduled'; }">Programados</button>
                                <button type="button" t-att-class="state.tripFilter === 'completed' ? 'is-active' : ''" t-on-click="() => { state.tripFilter = 'completed'; }">Finalizados</button>
                            </div>
                            <button type="button" class="grx-btn grx-btn--sm" t-on-click="() => this.openTrips()">Ver todos</button>
                        </div>
                    </div>

                    <div t-if="!this.filteredTrips.length" class="grx-empty">
                        <i class="fa fa-road" aria-hidden="true"/>
                        <strong>No hay recorridos que coincidan</strong>
                        <p>Programa un nuevo recorrido operacional o limpia los filtros de búsqueda.</p>
                    </div>

                    <div t-else="" class="grx-table-wrap">
                        <table class="grx-table">
                            <thead>
                                <tr>
                                    <th>Recorrido</th>
                                    <th>Ruta</th>
                                    <th>Vehículo</th>
                                    <th>Conductor</th>
                                    <th>Inicio (ECT)</th>
                                    <th>Origen / GPS</th>
                                    <th>Estado</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="this.filteredTrips" t-as="trip" t-key="trip.id">
                                    <tr t-on-click="() => this.openTripDetail(trip.id)">
                                        <td><strong><t t-esc="trip.name"/></strong></td>
                                        <td><t t-esc="trip.route_name"/></td>
                                        <td><t t-esc="trip.vehicle_name"/></td>
                                        <td><t t-esc="trip.driver_name"/></td>
                                        <td class="grx-num"><t t-esc="trip.scheduled_start_local"/></td>
                                        <td>
                                            <span t-if="trip.source_type === 'simulated'" class="grx-pill is-amber">Simulado</span>
                                            <span t-else="" class="grx-pill is-blue">Real</span>
                                            <span class="grx-item-sub ms-1"><t t-esc="trip.position_count"/> pts</span>
                                        </td>
                                        <td>
                                            <span t-attf-class="grx-pill #{this.getStateBadgeClass(trip.state)}">
                                                <t t-esc="trip.state_label"/>
                                            </span>
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </div>
                </section>
            </div>
        </div>
    </t>
</templates>
