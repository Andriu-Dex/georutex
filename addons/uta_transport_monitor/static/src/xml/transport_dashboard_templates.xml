<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="uta_transport_monitor.TransportDashboardAction" owl="1">
        <div class="grx-ops-page grx-analytics-page" t-ref="analyticsRoot">
            <div class="grx-ops-container">
                <!-- 1. ANALYST HEADER: "ANÁLISIS DEL SERVICIO" -->
                <header class="grx-page-header">
                    <div class="grx-page-heading">
                        <div class="grx-eyebrow">
                            <span class="grx-eyebrow-dot" aria-hidden="true"/>
                            <span>Evaluación e indicadores</span>
                            <span class="grx-eyebrow-sep">·</span>
                            <span>
                                Fuente:
                                <t t-esc="state.filters.source_type == 'real' ? 'Solo real' : (state.filters.source_type == 'simulated' ? 'Solo simulado' : 'Combinado')"/>
                            </span>
                        </div>
                        <h1 class="grx-page-title">Análisis del servicio</h1>
                    </div>
                    <div class="grx-header-actions">
                        <button type="button"
                                class="grx-btn"
                                t-on-click="openEvaluationsList"
                                title="Consultar evaluaciones guardadas y sus parámetros">
                            <i class="fa fa-history" aria-hidden="true"/>
                            <span>Auditoría de evaluaciones</span>
                        </button>
                        <button type="button"
                                class="grx-btn"
                                t-on-click="refreshDashboard"
                                t-att-disabled="state.isLoading"
                                title="Actualizar indicadores y posiciones">
                            <i t-attf-class="fa fa-refresh #{state.isLoading ? 'fa-spin' : ''}" aria-hidden="true"/>
                            <span>Actualizar</span>
                        </button>
                    </div>
                </header>

                <!-- 2. COMPACT ANALYTICAL FILTER TOOLBAR (Always visible Real / Simulated / Combined separation!) -->
                <section class="grx-card grx-filter-bar-card" aria-label="Filtros de análisis">
                    <div class="grx-filter-bar-row">
                        <div class="grx-filter-bar-group">
                            <span class="grx-filter-bar-label">Período</span>
                            <div class="grx-segmented" role="group" aria-label="Período del análisis">
                                <button type="button" t-att-class="state.activePreset === 'today' ? 'is-active' : ''" t-on-click="() => this.setDatePreset('today')">Hoy</button>
                                <button type="button" t-att-class="state.activePreset === 'week' ? 'is-active' : ''" t-on-click="() => this.setDatePreset('week')">Semana</button>
                                <button type="button" t-att-class="state.activePreset === 'month' ? 'is-active' : ''" t-on-click="() => this.setDatePreset('month')">Mes</button>
                                <button type="button" t-att-class="state.activePreset === 'all' ? 'is-active' : ''" t-on-click="() => this.setDatePreset('all')">Histórico</button>
                            </div>
                        </div>

                        <div class="grx-filter-bar-group">
                            <span class="grx-filter-bar-label">Fuente de datos</span>
                            <div class="grx-segmented" role="group" aria-label="Fuente de datos">
                                <button type="button" t-att-class="state.filters.source_type === 'combined' ? 'is-active' : ''" t-on-click="() => this.onSourceTypeChange('combined')">Combinado</button>
                                <button type="button" t-att-class="state.filters.source_type === 'real' ? 'is-active' : ''" t-on-click="() => this.onSourceTypeChange('real')">Real</button>
                                <button type="button" t-att-class="state.filters.source_type === 'simulated' ? 'is-active' : ''" t-on-click="() => this.onSourceTypeChange('simulated')">Simulado</button>
                            </div>
                        </div>

                        <div class="grx-filter-bar-actions">
                            <button type="button"
                                    t-attf-class="grx-btn #{state.filtersOpen ? 'grx-btn--primary' : ''}"
                                    t-att-aria-expanded="state.filtersOpen"
                                    t-on-click="toggleFilterPanel">
                                <i class="fa fa-sliders" aria-hidden="true"/>
                                <span>Más filtros</span>
                            </button>
                            <button t-if="this.hasActiveFilters"
                                    type="button"
                                    class="grx-btn grx-btn--sm"
                                    t-on-click="onResetFilters">
                                Limpiar
                            </button>
                        </div>
                    </div>

                    <form t-if="state.filtersOpen"
                          class="grx-filter-drawer"
                          t-on-submit="onFilterSubmit">
                        <div class="grx-filter-field">
                            <label for="georutex-date-from">Desde</label>
                            <input id="georutex-date-from" type="date" t-model="state.filters.date_from"/>
                        </div>
                        <div class="grx-filter-field">
                            <label for="georutex-date-to">Hasta</label>
                            <input id="georutex-date-to" type="date" t-model="state.filters.date_to"/>
                        </div>
                        <div class="grx-filter-field">
                            <label for="georutex-route-filter">Ruta</label>
                            <select id="georutex-route-filter" t-model="state.filters.route_id">
                                <option value="">Todas las rutas</option>
                                <t t-foreach="state.availableRoutes" t-as="route" t-key="route.id">
                                    <option t-att-value="route.id"><t t-esc="route.name"/></option>
                                </t>
                            </select>
                        </div>
                        <div class="grx-filter-field">
                            <label for="georutex-vehicle-filter">Vehículo</label>
                            <select id="georutex-vehicle-filter" t-model="state.filters.vehicle_id">
                                <option value="">Todos los vehículos</option>
                                <t t-foreach="state.availableVehicles" t-as="vehicle" t-key="vehicle.id">
                                    <option t-att-value="vehicle.id"><t t-esc="vehicle.name"/></option>
                                </t>
                            </select>
                        </div>
                        <div class="grx-filter-drawer-btns">
                            <button type="submit" class="grx-btn grx-btn--primary">Aplicar</button>
                            <button type="button" class="grx-btn" t-on-click="onResetFilters">Restablecer</button>
                        </div>
                    </form>
                </section>

                <!-- 3. FOUR EXECUTIVE SUMMARY CARDS -->
                <section class="grx-summary-grid" aria-label="Resumen ejecutivo del servicio">
                    <article class="grx-summary-card is-blue" role="button" tabindex="0" t-on-click="() => this.openTripsList('all')">
                        <div class="grx-kpi-head">
                            <span>Recorridos evaluados</span>
                            <i class="fa fa-bus grx-kpi-ico" aria-hidden="true"/>
                        </div>
                        <div class="grx-summary-row">
                            <strong class="grx-kpi-val" data-grx-counter="1">
                                <t t-esc="state.kpis['MT-01'] ? state.kpis['MT-01'].sample_size : 0"/>
                            </strong>
                            <span class="grx-pill is-blue">Muestra n</span>
                        </div>
                        <div class="grx-item-sub">Base evaluable de cumplimiento</div>
                    </article>

                    <article class="grx-summary-card is-green" role="button" tabindex="0" t-on-click="() => this.openTripsList('compliant')">
                        <div class="grx-kpi-head">
                            <span>Recorridos conformes</span>
                            <i class="fa fa-check-circle grx-kpi-ico" aria-hidden="true"/>
                        </div>
                        <div class="grx-summary-row">
                            <strong class="grx-kpi-val" data-grx-counter="1">
                                <t t-esc="state.summary.compliant_trips_gross || 0"/>
                            </strong>
                            <span t-if="state.kpis['MT-01'] and !state.kpis['MT-01'].is_na" class="grx-pill is-green">
                                <t t-esc="state.kpis['MT-01'].display_value"/>
                            </span>
                            <span t-else="" class="grx-pill is-amber">N/A</span>
                        </div>
                        <div class="grx-item-sub">
                            Bruto: <strong t-esc="state.summary.compliant_trips_gross || 0"/> · Ajustado: <strong t-esc="state.summary.compliant_trips_adjusted || 0"/>
                        </div>
                    </article>

                    <article class="grx-summary-card is-red" role="button" tabindex="0" t-on-click="openIncidentsList">
                        <div class="grx-kpi-head">
                            <span>Incidencias registradas</span>
                            <i class="fa fa-exclamation-triangle grx-kpi-ico" aria-hidden="true"/>
                        </div>
                        <div class="grx-summary-row">
                            <strong class="grx-kpi-val" data-grx-counter="1">
                                <t t-esc="state.summary.total_incidents || 0"/>
                            </strong>
                            <span t-if="state.summary.total_incidents" class="grx-pill is-red">Revisar</span>
                            <span t-else="" class="grx-pill is-green">Sin novedades</span>
                        </div>
                        <div class="grx-item-sub">Detecciones automáticas y manuales</div>
                    </article>

                    <article class="grx-summary-card is-amber" role="button" tabindex="0" t-on-click="() => this.openTripsList('all')">
                        <div class="grx-kpi-head">
                            <span>Puntualidad general</span>
                            <i class="fa fa-clock-o grx-kpi-ico" aria-hidden="true"/>
                        </div>
                        <div class="grx-summary-row">
                            <strong class="grx-kpi-val">
                                <t t-esc="state.kpis['MT-02'] ? state.kpis['MT-02'].display_value : 'N/A'"/>
                            </strong>
                            <span t-if="state.kpis['MT-02'] and !state.kpis['MT-02'].is_na" class="grx-pill is-blue">Calculada</span>
                            <span t-else="" class="grx-pill is-muted">Sin muestra</span>
                        </div>
                        <div class="grx-item-sub">
                            Muestra n = <t t-esc="state.kpis['MT-02'] ? state.kpis['MT-02'].sample_size : 0"/>
                        </div>
                    </article>
                </section>

                <!-- COMPACT ANALYTICAL EMPTY BANNER (when n=0 so KPIs remain visible without giant void) -->
                <div t-if="!state.isLoading and state.kpis['MT-01'] and state.kpis['MT-01'].sample_size === 0"
                     class="grx-ana-empty-banner" role="status">
                    <div class="grx-ana-empty-banner-icon" aria-hidden="true">
                        <i class="fa fa-bar-chart"/>
                    </div>
                    <div class="grx-ana-empty-banner-copy">
                        <strong>Sin recorridos evaluados para el corte seleccionado (n = 0)</strong>
                        <span t-if="state.activePreset !== 'all'">Los indicadores muestran <strong>N/A</strong> por ausencia de muestra en este rango. Puedes ampliar el período a <em>Histórico</em> o ajustar los filtros.</span>
                        <span t-else="">Los indicadores muestran <strong>N/A</strong> porque aún no existen recorridos evaluados para la fuente seleccionada.</span>
                    </div>
                    <button t-if="state.activePreset !== 'all'"
                            type="button"
                            class="grx-btn grx-btn--sm grx-btn--primary"
                            t-on-click="() => this.setDatePreset('all')">
                        Ver histórico
                    </button>
                </div>

                <!-- 4. GAUGES + DAILY TREND + FLEET PREVIEW -->
                <section class="grx-ana-main-grid">
                    <div class="grx-card">
                        <div class="grx-card-header">
                            <div>
                                <h2 class="grx-card-title">Evolución de cumplimiento y puntualidad</h2>
                                <p class="grx-card-sub">Tendencia diaria por recorridos evaluados (bruto, ajustado y puntualidad)</p>
                            </div>
                            <span class="grx-code-tag">MT-01 · MT-02</span>
                        </div>
                        <div class="grx-card-body">
                            <div t-if="this.hasDailyTrendData"
                                 t-ref="trendChartCanvas"
                                 class="grx-echart-box grx-echart-box--lg"
                                 role="img"
                                 aria-label="Tendencia de cumplimiento y puntualidad"/>
                            <div t-else="" class="grx-empty grx-empty--compact">
                                <i class="fa fa-line-chart" aria-hidden="true"/>
                                <strong>Sin serie diaria en este período</strong>
                                <p>Las líneas de cumplimiento bruto, ajustado y puntualidad aparecerán al evaluar recorridos.</p>
                            </div>
                        </div>
                    </div>

                    <div class="grx-ana-side-col">
                        <div class="grx-gauge-pair">
                            <article class="grx-card">
                                <div class="grx-card-header">
                                    <div>
                                        <h2 class="grx-card-title">Cumplimiento de rutas</h2>
                                        <p class="grx-card-sub">Meta operativa ≥ 90%</p>
                                    </div>
                                    <span class="grx-code-tag">MT-01</span>
                                </div>
                                <div class="grx-card-body grx-gauge-body">
                                    <div t-if="state.kpis['MT-01'] and !state.kpis['MT-01'].is_na" t-ref="mt01GaugeBox" class="grx-echart-gauge"/>
                                    <div t-else="" class="grx-gauge-na">
                                        <strong>N/A</strong>
                                        <span>Sin muestra evaluada (n = 0)</span>
                                    </div>
                                </div>
                            </article>

                            <article class="grx-card">
                                <div class="grx-card-header">
                                    <div>
                                        <h2 class="grx-card-title">Puntualidad general</h2>
                                        <p class="grx-card-sub">Meta operativa ≥ 85%</p>
                                    </div>
                                    <span class="grx-code-tag">MT-02</span>
                                </div>
                                <div class="grx-card-body grx-gauge-body">
                                    <div t-if="state.kpis['MT-02'] and !state.kpis['MT-02'].is_na" t-ref="mt02GaugeBox" class="grx-echart-gauge"/>
                                    <div t-else="" class="grx-gauge-na">
                                        <strong>N/A</strong>
                                        <span>Sin muestra evaluada (n = 0)</span>
                                    </div>
                                </div>
                            </article>
                        </div>

                        <article class="grx-card">
                            <div class="grx-card-header">
                                <div>
                                    <h2 class="grx-card-title">Ubicaciones activas</h2>
                                    <p class="grx-card-sub"><t t-esc="state.livePositionCount"/> unidades con posición GPS</p>
                                </div>
                                <button type="button" class="grx-btn grx-btn--sm" t-on-click="openLiveMap">
                                    <span>Abrir mapa</span>
                                    <i class="fa fa-external-link" aria-hidden="true"/>
                                </button>
                            </div>
                            <div class="grx-map-wrap grx-map-wrap--preview">
                                <div t-ref="mapPreviewCanvas" class="grx-map-canvas"/>
                                <div t-if="state.liveMapStatus === 'empty'" class="grx-map-empty-overlay">
                                    <strong>Sin posiciones GPS activas</strong>
                                    <div>Las unidades aparecerán al registrar coordenadas válidas.</div>
                                </div>
                                <div t-if="state.liveMapStatus === 'error'" class="grx-map-empty-overlay">
                                    <strong>Mapa no disponible</strong>
                                    <div><t t-esc="state.liveMapError"/></div>
                                </div>
                            </div>
                        </article>
                    </div>
                </section>

                <!-- 5. OPERATIONAL INDICATORS GRID (MT-01 .. MT-08) -->
                <section class="grx-section-block" aria-label="Indicadores de desempeño operativo">
                    <div class="grx-section-head">
                        <div>
                            <h2>Indicadores de desempeño operativo</h2>
                            <p>Pasa el cursor sobre cualquier tarjeta para consultar fórmula, fuente, versión de reglas y muestra.</p>
                        </div>
                        <span class="grx-pill is-muted">
                            <t t-esc="state.kpis['MT-01'] ? state.kpis['MT-01'].period : 'Histórico completo'"/>
                        </span>
                    </div>
                    <div class="grx-metric-grid">
                        <t t-foreach="this.transportMetricCards" t-as="metric" t-key="metric.id">
                            <button type="button"
                                    t-attf-class="grx-metric-card is-#{metric.tone}"
                                    t-att-title="this.getMetricTooltip(metric.metric)"
                                    t-att-aria-label="metric.title + ' (' + metric.id + '). ' + this.getMetricTooltip(metric.metric)"
                                    t-on-click="() => this.openMetric(metric.id)">
                                <div class="grx-metric-top">
                                    <span class="grx-metric-title"><t t-esc="metric.title"/></span>
                                    <span class="grx-code-tag"><t t-esc="metric.id"/></span>
                                </div>
                                <strong class="grx-metric-val">
                                    <t t-esc="metric.metric.display_value || 'N/A'"/>
                                </strong>
                                <span class="grx-metric-sub">
                                    <t t-esc="this.getMetricSecondary(metric.id, metric.metric) || (metric.metric.is_na ? 'Sin muestra suficiente' : 'Resultado calculado')"/>
                                </span>
                                <div class="grx-metric-bar" aria-hidden="true">
                                    <t t-foreach="[1, 2, 3, 4, 5]" t-as="segment" t-key="segment">
                                        <span t-att-class="this.getMetricSegmentClass(metric.metric, segment)"/>
                                    </t>
                                </div>
                                <div class="grx-metric-foot">
                                    <span>n = <t t-esc="metric.metric.sample_size !== undefined ? metric.metric.sample_size : 0"/></span>
                                    <span><t t-esc="this.getMetricSource(metric.metric)"/></span>
                                </div>
                            </button>
                        </t>
                    </div>
                </section>

                <!-- 6. ROUTE COMPARISON + INCIDENTS DISTRIBUTION -->
                <section class="grx-two-col">
                    <article class="grx-card">
                        <div class="grx-card-header">
                            <div>
                                <h2 class="grx-card-title">Comparativa por ruta</h2>
                                <p class="grx-card-sub">Cumplimiento bruto frente a cumplimiento ajustado con incidencias justificadas</p>
                            </div>
                        </div>
                        <div class="grx-card-body">
                            <t t-if="state.charts.route_comparison and state.charts.route_comparison.length">
                                <div t-ref="routeChartBox" class="grx-echart-box mb-3"/>
                                <div class="grx-table-wrap">
                                    <table class="grx-table">
                                        <thead>
                                            <tr>
                                                <th>Ruta</th>
                                                <th>Recorridos</th>
                                                <th>Bruto</th>
                                                <th>Ajustado</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <t t-foreach="state.charts.route_comparison" t-as="route" t-key="route.route_name">
                                                <tr>
                                                    <td><strong><t t-esc="route.route_name"/></strong></td>
                                                    <td class="grx-num"><t t-esc="route.total_trips"/></td>
                                                    <td class="grx-num"><t t-esc="route.compliance_gross_pct !== null ? route.compliance_gross_pct + ' %' : 'N/A'"/></td>
                                                    <td class="grx-num"><t t-esc="route.compliance_adj_pct !== null ? route.compliance_adj_pct + ' %' : 'N/A'"/></td>
                                                </tr>
                                            </t>
                                        </tbody>
                                    </table>
                                </div>
                            </t>
                            <div t-else="" class="grx-empty">
                                <i class="fa fa-map-signs" aria-hidden="true"/>
                                <strong>Sin rutas evaluadas en este período</strong>
                                <p>Las comparativas aparecerán al registrar evaluaciones de recorridos.</p>
                            </div>
                        </div>
                    </article>

                    <article class="grx-card">
                        <div class="grx-card-header">
                            <div>
                                <h2 class="grx-card-title">Distribución de incidencias</h2>
                                <p class="grx-card-sub">Eventos por categoría para el período y fuente seleccionados</p>
                            </div>
                            <button type="button" class="grx-btn grx-btn--sm" t-on-click="openIncidentsList">Ver registro</button>
                        </div>
                        <div class="grx-card-body">
                            <div t-if="this.hasIncidentChartData"
                                 t-ref="incidentChartCanvas"
                                 class="grx-echart-box"
                                 role="img"
                                 aria-label="Distribución de incidencias por tipo"/>
                            <div t-else="" class="grx-empty grx-empty--chart">
                                <i class="fa fa-check-circle" aria-hidden="true"/>
                                <strong>Sin incidencias registradas</strong>
                                <p>No se han detectado ni reportado incidencias en este corte.</p>
                            </div>
                        </div>
                    </article>
                </section>

                <!-- 7. TECHNICAL QUALITY INDICATORS (MCS-01 .. MCS-04) -->
                <section class="grx-card grx-quality-card" aria-label="Calidad técnica del servicio">
                    <div class="grx-card-header">
                        <div>
                            <h2 class="grx-card-title">Calidad técnica y telemetría</h2>
                            <p class="grx-card-sub">Integridad GPS, sincronización, tiempo de respuesta y detección (MCS-01 a MCS-04)</p>
                        </div>
                        <button type="button"
                                class="grx-btn grx-btn--sm"
                                t-on-click="onRunQualityBenchmarks"
                                t-att-disabled="state.qualityRunning">
                            <i t-attf-class="fa #{state.qualityRunning ? 'fa-spinner fa-spin' : 'fa-play'}" aria-hidden="true"/>
                            <span>Ejecutar medición</span>
                        </button>
                    </div>
                    <div class="grx-card-body">
                        <div class="grx-metric-grid">
                            <t t-foreach="this.qualityMetricCards" t-as="metric" t-key="metric.id">
                                <article t-attf-class="grx-metric-card is-#{metric.tone}"
                                         t-att-title="this.getMetricTooltip(metric.metric)">
                                    <div class="grx-metric-top">
                                        <span class="grx-metric-title"><t t-esc="metric.title"/></span>
                                        <span class="grx-code-tag"><t t-esc="metric.id"/></span>
                                    </div>
                                    <strong class="grx-metric-val">
                                        <t t-esc="metric.metric.display_value || 'N/A'"/>
                                    </strong>
                                    <span class="grx-metric-sub">
                                        <t t-esc="metric.metric.is_na ? 'Sin muestra suficiente' : (metric.metric.unit || 'Medición registrada')"/>
                                    </span>
                                    <div class="grx-metric-bar" aria-hidden="true">
                                        <t t-foreach="[1, 2, 3, 4, 5]" t-as="segment" t-key="segment">
                                            <span t-att-class="this.getMetricSegmentClass(metric.metric, segment)"/>
                                        </t>
                                    </div>
                                    <div class="grx-metric-foot">
                                        <span>n = <t t-esc="metric.metric.sample_size !== undefined ? metric.metric.sample_size : 0"/></span>
                                        <span><t t-esc="this.getMetricSource(metric.metric)"/></span>
                                    </div>
                                </article>
                            </t>
                        </div>
                    </div>
                </section>
            </div>
        </div>
    </t>
</templates>
