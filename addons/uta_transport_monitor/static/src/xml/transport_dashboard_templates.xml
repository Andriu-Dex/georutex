<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="uta_transport_monitor.TransportDashboardAction" owl="1">
        <div class="georutex-dashboard-container">
            <header class="georutex-dashboard-header">
                <div class="georutex-dashboard-title">
                    <h1>Monitoreo y métricas de transporte</h1>
                    <span class="georutex-context-badge">Panel de Control</span>
                </div>
                <button type="button"
                        class="btn georutex-button-light"
                        t-on-click="openEvaluationsList"
                        title="Consultar evaluaciones y sus parámetros guardados">
                    <i class="fa fa-history me-1"/> Auditoría
                </button>
            </header>

            <div class="georutex-dashboard-toolbar">
                <div class="georutex-period-pills" role="group" aria-label="Período del dashboard">
                    <button type="button"
                            t-attf-class="georutex-period-button #{state.activePreset == 'today' ? 'active' : ''}"
                            t-on-click="() => this.setDatePreset('today')">Hoy</button>
                    <button type="button"
                            t-attf-class="georutex-period-button #{state.activePreset == 'week' ? 'active' : ''}"
                            t-on-click="() => this.setDatePreset('week')">Esta semana</button>
                    <button type="button"
                            t-attf-class="georutex-period-button #{state.activePreset == 'month' ? 'active' : ''}"
                            t-on-click="() => this.setDatePreset('month')">Este mes</button>
                    <button type="button"
                            t-attf-class="georutex-period-button #{state.activePreset == 'all' ? 'active' : ''}"
                            t-on-click="() => this.setDatePreset('all')">Histórico</button>
                </div>
                <div class="georutex-toolbar-actions">
                    <button type="button"
                            class="btn georutex-button-light"
                            t-on-click="refreshDashboard"
                            title="Actualizar métricas y posiciones GPS">
                        <i class="fa fa-refresh me-1"/> Actualizar
                    </button>
                    <button type="button"
                            class="btn georutex-button-blue"
                            t-att-aria-expanded="state.filtersOpen"
                            t-on-click="toggleFilterPanel">
                        <i class="fa fa-filter me-1"/> Filtrar
                    </button>
                </div>
            </div>

            <form t-if="state.filtersOpen"
                  class="georutex-filter-panel"
                  t-on-submit="onFilterSubmit">
                <div class="georutex-filter-field">
                    <label for="georutex-date-from">Desde</label>
                    <input id="georutex-date-from" type="date" t-model="state.filters.date_from"/>
                </div>
                <div class="georutex-filter-field">
                    <label for="georutex-date-to">Hasta</label>
                    <input id="georutex-date-to" type="date" t-model="state.filters.date_to"/>
                </div>
                <div class="georutex-filter-field">
                    <label for="georutex-route-filter">Ruta</label>
                    <select id="georutex-route-filter" t-model="state.filters.route_id">
                        <option value="">Todas las rutas</option>
                        <t t-foreach="state.availableRoutes" t-as="route" t-key="route.id">
                            <option t-att-value="route.id"><t t-esc="route.name"/></option>
                        </t>
                    </select>
                </div>
                <div class="georutex-filter-field">
                    <label for="georutex-vehicle-filter">Vehículo</label>
                    <select id="georutex-vehicle-filter" t-model="state.filters.vehicle_id">
                        <option value="">Todos los vehículos</option>
                        <t t-foreach="state.availableVehicles" t-as="vehicle" t-key="vehicle.id">
                            <option t-att-value="vehicle.id"><t t-esc="vehicle.name"/></option>
                        </t>
                    </select>
                </div>
                <div class="georutex-filter-field">
                    <label for="georutex-source-filter">Fuente</label>
                    <select id="georutex-source-filter" t-model="state.filters.source_type">
                        <option value="combined">Real y simulado</option>
                        <option value="real">Solo real</option>
                        <option value="simulated">Solo simulado</option>
                    </select>
                </div>
                <div class="georutex-filter-field">
                    <span class="d-block" aria-hidden="true">&#160;</span>
                    <button type="submit" class="btn georutex-button-blue">
                        Aplicar filtros
                    </button>
                </div>
                <div class="georutex-filter-field">
                    <span class="d-block" aria-hidden="true">&#160;</span>
                    <button type="button"
                            class="btn georutex-button-light"
                            t-on-click="onResetFilters">
                        Limpiar
                    </button>
                </div>
            </form>

            <main class="georutex-dashboard-content">
                <t t-if="state.isLoading">
                    <div class="georutex-dashboard-loading" role="status" aria-live="polite">
                        <span class="spinner-border" aria-hidden="true"/>
                        <span class="visually-hidden">Cargando métricas…</span>
                    </div>
                </t>

                <section class="georutex-dashboard-section georutex-summary-grid"
                         aria-label="Resumen operativo">
                    <button type="button"
                            class="georutex-summary-card georutex-summary-card--blue"
                            t-on-click="() => this.openTripsList('all')">
                        <span class="georutex-summary-label">
                            Recorridos evaluados
                            <i class="fa fa-bus georutex-summary-icon" aria-hidden="true"/>
                        </span>
                        <span class="georutex-summary-value-row">
                            <strong class="georutex-summary-value">
                                <t t-esc="state.kpis['MT-01'] ? state.kpis['MT-01'].sample_size : 0"/>
                            </strong>
                            <span class="georutex-status-pill georutex-status-pill--blue">Evaluables</span>
                        </span>
                        <span class="georutex-summary-note">Muestra usada en MT-01</span>
                    </button>

                    <button type="button"
                            class="georutex-summary-card georutex-summary-card--green"
                            t-on-click="() => this.openTripsList('compliant')">
                        <span class="georutex-summary-label">
                            Recorridos conformes
                            <i class="fa fa-check-circle georutex-summary-icon" aria-hidden="true"/>
                        </span>
                        <span class="georutex-summary-value-row">
                            <strong class="georutex-summary-value">
                                <t t-esc="state.summary.compliant_trips_gross || 0"/>
                            </strong>
                            <span t-if="state.kpis['MT-01'] and !state.kpis['MT-01'].is_na"
                                  class="georutex-status-pill georutex-status-pill--green">
                                <t t-esc="state.kpis['MT-01'].display_value"/>
                            </span>
                            <span t-else="" class="georutex-status-pill georutex-status-pill--amber">N/A</span>
                        </span>
                        <span class="georutex-summary-note">
                            Bruto: <t t-esc="state.summary.compliant_trips_gross || 0"/>
                            <span class="mx-1">·</span>
                            Ajustado: <t t-esc="state.summary.compliant_trips_adjusted || 0"/>
                        </span>
                    </button>

                    <button type="button"
                            class="georutex-summary-card georutex-summary-card--red"
                            t-on-click="openIncidentsList">
                        <span class="georutex-summary-label">
                            Incidencias totales
                            <i class="fa fa-exclamation-triangle georutex-summary-icon" aria-hidden="true"/>
                        </span>
                        <span class="georutex-summary-value-row">
                            <strong class="georutex-summary-value">
                                <t t-esc="state.summary.total_incidents || 0"/>
                            </strong>
                            <span t-if="state.summary.total_incidents"
                                  class="georutex-status-pill georutex-status-pill--red">Revisar</span>
                            <span t-else="" class="georutex-status-pill georutex-status-pill--green">Sin incidencias</span>
                        </span>
                        <span class="georutex-summary-note">Automáticas y reportadas</span>
                    </button>

                    <button type="button"
                            class="georutex-summary-card georutex-summary-card--amber"
                            t-on-click="() => this.openTripsList('all')">
                        <span class="georutex-summary-label">
                            Puntualidad general
                            <i class="fa fa-clock-o georutex-summary-icon" aria-hidden="true"/>
                        </span>
                        <span class="georutex-summary-value-row">
                            <strong class="georutex-summary-value">
                                <t t-esc="state.kpis['MT-02'] ? state.kpis['MT-02'].display_value : 'N/A'"/>
                            </strong>
                            <span t-if="state.kpis['MT-02'] and !state.kpis['MT-02'].is_na"
                                  class="georutex-status-pill georutex-status-pill--amber">Calculada</span>
                            <span t-else="" class="georutex-status-pill georutex-status-pill--amber">Sin muestra</span>
                        </span>
                        <span class="georutex-summary-note">
                            n =
                            <t t-esc="state.kpis['MT-02'] ? state.kpis['MT-02'].sample_size : 0"/>
                        </span>
                    </button>
                </section>

                <section class="georutex-dashboard-section georutex-main-grid">
                    <article class="georutex-surface-card">
                        <div class="georutex-card-heading">
                            <div>
                                <h2>Cumplimiento y puntualidad</h2>
                                <p>Tendencia diaria · porcentajes calculados sobre su muestra</p>
                            </div>
                            <i class="fa fa-line-chart text-primary" aria-hidden="true"/>
                        </div>
                        <t t-if="this.hasDailyTrendData">
                            <div class="georutex-chart-area">
                                <canvas t-ref="trendChartCanvas"
                                        role="img"
                                        aria-label="Gráfico de cumplimiento de rutas y puntualidad"/>
                            </div>
                        </t>
                        <t t-else="">
                            <div class="georutex-chart-empty">
                                No hay recorridos evaluables para graficar en este período.
                            </div>
                        </t>
                    </article>

                    <article class="georutex-surface-card">
                        <div class="georutex-card-heading">
                            <div>
                                <h2>Ubicaciones de flota</h2>
                                <p>Posiciones GPS disponibles · actualización cada 30 s</p>
                            </div>
                            <i class="fa fa-map-marker text-primary" aria-hidden="true"/>
                        </div>
                        <div class="georutex-map-preview">
                            <div t-ref="mapPreviewCanvas" class="georutex-map-preview-canvas"/>
                            <div class="georutex-map-preview-topline">
                                <span class="georutex-map-count">
                                    <t t-esc="state.livePositionCount"/> con ubicación
                                </span>
                                <button type="button"
                                        class="georutex-map-link"
                                        t-on-click="openLiveMap">
                                    Abrir mapa <i class="fa fa-external-link ms-1" aria-hidden="true"/>
                                </button>
                            </div>
                            <div t-if="state.liveMapStatus == 'empty'"
                                 class="georutex-map-preview-empty">
                                <img src="/uta_transport_monitor/static/src/img/mapa.webp"
                                     alt="Vista ilustrativa de buses y rutas; no representa posiciones GPS reales."/>
                                <div class="georutex-map-preview-message">
                                    <span class="georutex-status-pill georutex-status-pill--amber">Vista ilustrativa</span>
                                    <strong>Sin posiciones GPS disponibles</strong>
                                    <span>El mapa real se mostrará cuando ingresen coordenadas válidas.</span>
                                </div>
                            </div>
                            <div t-if="state.liveMapStatus == 'error'"
                                 class="georutex-map-error"
                                 role="status">
                                <i class="fa fa-exclamation-circle me-1" aria-hidden="true"/>
                                <t t-esc="state.liveMapError"/>
                            </div>
                            <span t-if="state.liveMapStatus == 'loading'"
                                  class="georutex-map-count georutex-map-loading">
                                Consultando GPS…
                            </span>
                        </div>
                    </article>
                </section>

                <section class="georutex-dashboard-section">
                    <div class="georutex-section-heading">
                        <h2>Métricas de control · MT-01 a MT-08</h2>
                        <span class="georutex-section-meta">
                            Fuente:
                            <t t-esc="state.filters.source_type == 'real' ? 'Real' : (state.filters.source_type == 'simulated' ? 'Simulado' : 'Combinado')"/>
                            <span class="mx-1">·</span>
                            <t t-esc="state.kpis['MT-01'] ? state.kpis['MT-01'].period : 'Todo el período'"/>
                        </span>
                    </div>
                    <div class="georutex-metric-grid">
                        <t t-foreach="this.transportMetricCards" t-as="metric" t-key="metric.id">
                            <button type="button"
                                    t-attf-class="georutex-metric-card georutex-tone-#{metric.tone}"
                                    t-att-title="this.getMetricTooltip(metric.metric)"
                                    t-att-aria-label="metric.id + ' ' + metric.title + '. ' + this.getMetricTooltip(metric.metric)"
                                    t-on-click="() => this.openMetric(metric.id)">
                                <span class="georutex-metric-topline">
                                    <span class="georutex-metric-code"><t t-esc="metric.id"/></span>
                                    <i class="fa fa-info-circle text-muted" aria-hidden="true"/>
                                </span>
                                <span class="georutex-metric-title"><t t-esc="metric.title"/></span>
                                <strong class="georutex-metric-value">
                                    <t t-esc="metric.metric.display_value || 'N/A'"/>
                                </strong>
                                <span class="georutex-metric-secondary">
                                    <t t-esc="this.getMetricSecondary(metric.id, metric.metric)"/>
                                </span>
                                <span class="georutex-metric-segments" aria-hidden="true">
                                    <t t-foreach="[1, 2, 3, 4, 5]" t-as="segment" t-key="segment">
                                        <span t-att-class="this.getMetricSegmentClass(metric.metric, segment)"/>
                                    </t>
                                </span>
                                <span class="georutex-metric-meta">
                                    <span>n = <t t-esc="metric.metric.sample_size !== undefined ? metric.metric.sample_size : 'N/A'"/></span>
                                    <span><t t-esc="this.getMetricSource(metric.metric)"/></span>
                                </span>
                            </button>
                        </t>
                    </div>
                </section>

                <details class="georutex-detail-section" t-on-toggle="onDetailsToggle">
                    <summary>Comparativas, incidencias y métricas complementarias</summary>
                    <div class="georutex-detail-content">
                        <div class="georutex-section-heading">
                            <h2>Métricas de calidad del software · MCS-01 a MCS-04</h2>
                            <button type="button"
                                    class="btn georutex-button-light"
                                    t-on-click="onRunQualityBenchmarks"
                                    t-att-disabled="state.qualityRunning">
                                <i t-attf-class="fa #{state.qualityRunning ? 'fa-spinner fa-spin' : 'fa-play'} me-1"/>
                                Ejecutar medición
                            </button>
                        </div>
                        <div class="georutex-metric-grid">
                            <t t-foreach="this.qualityMetricCards" t-as="metric" t-key="metric.id">
                                <article t-attf-class="georutex-metric-card georutex-tone-#{metric.tone}"
                                         t-att-title="this.getMetricTooltip(metric.metric)">
                                    <span class="georutex-metric-topline">
                                        <span class="georutex-metric-code"><t t-esc="metric.id"/></span>
                                        <i class="fa fa-info-circle text-muted" aria-hidden="true"/>
                                    </span>
                                    <span class="georutex-metric-title"><t t-esc="metric.title"/></span>
                                    <strong class="georutex-metric-value">
                                        <t t-esc="metric.metric.display_value || 'N/A'"/>
                                    </strong>
                                    <span class="georutex-metric-secondary">
                                        <t t-esc="metric.metric.is_na ? 'Sin muestra' : (metric.metric.unit || 'Resultado medido')"/>
                                    </span>
                                    <span class="georutex-metric-segments" aria-hidden="true">
                                        <t t-foreach="[1, 2, 3, 4, 5]" t-as="segment" t-key="segment">
                                            <span t-att-class="this.getMetricSegmentClass(metric.metric, segment)"/>
                                        </t>
                                    </span>
                                    <span class="georutex-metric-meta">
                                        <span>n = <t t-esc="metric.metric.sample_size !== undefined ? metric.metric.sample_size : 'N/A'"/></span>
                                        <span><t t-esc="this.getMetricSource(metric.metric)"/></span>
                                    </span>
                                </article>
                            </t>
                        </div>

                        <div class="georutex-secondary-grid mt-3">
                            <article class="georutex-surface-card">
                                <div class="georutex-card-heading">
                                    <div>
                                        <h2>Comparativa por ruta</h2>
                                        <p>Cumplimiento bruto y ajustado</p>
                                    </div>
                                </div>
                                <table class="georutex-data-table">
                                    <thead>
                                        <tr>
                                            <th>Ruta</th>
                                            <th>Recorridos</th>
                                            <th>Bruto</th>
                                            <th>Ajustado</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <t t-if="state.charts.route_comparison and state.charts.route_comparison.length">
                                            <t t-foreach="state.charts.route_comparison" t-as="route" t-key="route.route_name">
                                                <tr>
                                                    <td><t t-esc="route.route_name"/></td>
                                                    <td><t t-esc="route.total_trips"/></td>
                                                    <td><t t-esc="route.compliance_gross_pct !== null ? route.compliance_gross_pct + ' %' : 'N/A'"/></td>
                                                    <td><t t-esc="route.compliance_adj_pct !== null ? route.compliance_adj_pct + ' %' : 'N/A'"/></td>
                                                </tr>
                                            </t>
                                        </t>
                                        <t t-else="">
                                            <tr><td colspan="4" class="text-center">Sin rutas evaluadas en el período.</td></tr>
                                        </t>
                                    </tbody>
                                </table>
                            </article>

                            <article class="georutex-surface-card">
                                <div class="georutex-card-heading">
                                    <div>
                                        <h2>Incidencias por tipo</h2>
                                        <p>Registros del período y fuente seleccionados</p>
                                    </div>
                                </div>
                                <t t-if="this.hasIncidentChartData">
                                    <div class="georutex-chart-area">
                                        <canvas t-ref="incidentChartCanvas"
                                                role="img"
                                                aria-label="Incidencias agrupadas por tipo"/>
                                    </div>
                                </t>
                                <t t-else="">
                                    <div class="georutex-empty-state">Sin incidencias registradas en este período.</div>
                                </t>
                            </article>
                        </div>
                    </div>
                </details>
            </main>
        </div>
    </t>
</templates>
