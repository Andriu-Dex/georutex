# ==============================================================================
# GeoRutex — Infrastructure Environment Template (.env.example)
#
# IMPORTANT:
# - Copy this file to .env and adjust credentials for your environment.
# - NEVER commit real credentials, passwords, tokens, or GPS traces to Git.
# - Evaluation thresholds (route_corridor_m, lateness_tolerance_s, stop_radius_m,
#   speed limits, etc.) MUST NOT be defined here; they are stored in Odoo models
#   with historical snapshots according to requirements.md Section 7.1.
# ==============================================================================

# --- PostgreSQL Database ---
POSTGRES_DB=georutex
POSTGRES_USER=odoo
POSTGRES_PASSWORD=odoo_db_password_example
POSTGRES_PORT=5432
# Host port mapping (5433 by default to avoid conflict with existing host PostgreSQL services)
POSTGRES_HOST_PORT=5433

# --- Odoo 16 Configuration ---
ODOO_DB_HOST=postgres
ODOO_DB_PORT=5432
ODOO_DB_NAME=georutex
ODOO_DB_USER=odoo
ODOO_DB_PASSWORD=odoo_db_password_example
ODOO_HTTP_PORT=8069
ODOO_ADMIN_PASSWORD=odoo_admin_master_password_example

# --- Traccar GPS Server ---
# Private internal API base URL (accessible by Odoo backend over container network)
TRACCAR_API_BASE_URL=http://traccar:8082
TRACCAR_API_AUTH_METHOD=basic
TRACCAR_API_USERNAME=admin
TRACCAR_API_PASSWORD=traccar_admin_password_example

# Traccar Host Port Mappings (Administration kept private; OsmAnd HTTP for GPS receiver)
TRACCAR_WEB_PORT=8082
TRACCAR_OSMAND_PORT=5055

# Public GPS ingestion endpoint for mobile Traccar Client (e.g. via Cloudflare Tunnel or reverse proxy)
GPS_PUBLIC_INGEST_URL=https://gps.example.invalid

# --- Operational Display and Regional Settings ---
# Business display timezone (technical instants are stored in UTC)
TRANSPORT_TIMEZONE=America/Guayaquil
MAP_TILES_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
MAP_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors
LOG_LEVEL=INFO

